atic.com/store_item_assets/steam/apps/1062960/d51e5823702b5c42e10cd7b1274d8f98b607e3fc/ss_d51e5823702b5c42e10cd7b1274d8f98b607e3fc.600x338.jpg?t=1785494561", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/d51e5823702b5c42e10cd7b1274d8f98b607e3fc/ss_d51e5823702b5c42e10cd7b1274d8f98b607e3fc.1920x1080.jpg?t=1785494561"}, {"id": 9, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/0619192ed6b3a55431fcc4e90f59c63f8085a1a5/ss_0619192ed6b3a55431fcc4e90f59c63f8085a1a5.600x338.jpg?t=1785494561", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/0619192ed6b3a55431fcc4e90f59c63f8085a1a5/ss_0619192ed6b3a55431fcc4e90f59c63f8085a1a5.1920x1080.jpg?t=1785494561"}, {"id": 10, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/84f26f1e3e310619bb14180bc4d00c3b1b5e437c/ss_84f26f1e3e310619bb14180bc4d00c3b1b5e437c.600x338.jpg?t=1785494561", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/84f26f1e3e310619bb14180bc4d00c3b1b5e437c/ss_84f26f1e3e310619bb14180bc4d00c3b1b5e437c.1920x1080.jpg?t=1785494561"}, {"id": 11, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/55af7ef4c8aa87db43459ddeadfcfd0aa16d99d5/ss_55af7ef4c8aa87db43459ddeadfcfd0aa16d99d5.600x338.jpg?t=1785494561", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/55af7ef4c8aa87db43459ddeadfcfd0aa16d99d5/ss_55af7ef4c8aa87db43459ddeadfcfd0aa16d99d5.1920x1080.jpg?t=1785494561"}, {"id": 12, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/b906d4a6398e857299f8b168bf27e1af6457ad71/ss_b906d4a6398e857299f8b168bf27e1af6457ad71.600x338.jpg?t=1785494561", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1062960/b906d4a6398e857299f8b168bf27e1af6457ad71/ss_b906d4a6398e857299f8b168bf