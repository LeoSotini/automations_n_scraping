8f7eb7ea7866527b94513d1e.poster.avif?t=1785257701\" width=620 height=128 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/5f2d84298f7eb7ea7866527b94513d1e.webm?t=1785257701\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/5f2d84298f7eb7ea7866527b94513d1e.mp4?t=1785257701\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/2cd59a018f30b01d0eb7d38cb13aa05f.poster.avif?t=1785257701\" width=620 height=128 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/2cd59a018f30b01d0eb7d38cb13aa05f.webm?t=1785257701\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/2cd59a018f30b01d0eb7d38cb13aa05f.mp4?t=1785257701\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/db0c9ec754307da577906fdf4e104b9a.poster.avif?t=1785257701\" width=620 height=128 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/db0c9ec754307da577906fdf4e104b9a.webm?t=1785257701\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/db0c9ec754307da577906fdf4e104b9a.mp4?t=1785257701\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>NO LIFE: Zombie Survivor</strong> is a brutal survival roguelite where you’ll face endless hordes of relentless zombies in a battle for survival.  Choose from a varied roster of survivors, each equipped with unique abilities and playstyles, allowing you to customize your approach to every encounter. You can also acquire a loyal dog companion by your side, adding an extra layer of support in combat.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/5d2466c5f58f86eddde2df6abd037514.poster.avif?t=1785257701\" width=620 height=286 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/5d2466c5f58f86eddde2df6abd037514.webm?t=1785257701\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/5d2466c5f58f86eddde2df6abd037514.mp4?t=1785257701\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Prepare for an increasingly intense fight against the undead. Scavenge for powerful weapons and items scattered throughout procedurally generated environments. Adapt your strategy as you encounter different types of zombies, each presenting its own challenges. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Upgrade your character's skills and unlock new abilities as you progress, creating devastating combinations that can turn the tide of battle. With each wave, the hordes grow stronger, pushing you to improve your tactics and explore new synergies among your survivors, weapons, and your canine companion.</p>", "about_the_game": "<p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/28e8f5443c6fb0cdcd41ffcba6a1c78f.poster.avif?t=1785257701\" width=620 height=128 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1256730/extras/28e8f5443c6fb0cdcd41ffcba6a1c78f.webm?t=1785257701\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.aka