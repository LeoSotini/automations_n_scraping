ding potential in a mysterious world.", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1343950/header.jpg?t=1783399406", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1343950/d9ef681f9b17b51a6fdb97fc375ac4401fff5017/capsule_231x87.jpg?t=1783399406", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1343950/d9ef681f9b17b51a6fdb97fc375ac4401fff5017/capsule_184x69.jpg?t=1783399406", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>Graphics:</strong> Vulkan</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Corpse King Games"], "publishers": ["Corpse King Games"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "1", "description": "Action"}, {"id": "25", "description": "Adventure"}, {"id": "23", "description": "Indie"}, {"id": "3", "description": "RPG"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1343950/ss_3bdc4207ce7b0b4ac8ef36a20932126988c66cee.600x338.jpg?t=1783399406", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1343950/ss_3bdc4207ce7b0b4ac8ef36a20932126988c66cee.1920x1080.jpg?t=1783399406"}, {"id": 1, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1343950/ss_9d7b11adde0b65efc4d05a043055000759ee51d1.600x338.jpg?t=1783399406", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1343950/ss_9d7b11adde0b65efc4d05a043055000759ee51d1.1920x1080.jpg?t=1783399406"}, {"id": 2, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1343950/ss_06505491c073ac6b861187a18c94118db74abd38.600x