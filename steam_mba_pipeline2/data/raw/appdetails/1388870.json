steam/apps/1388870/extras/da83e05562b7b9e29852920805db02a3.mp4?t=1782220777\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/6da3fa6da80340a87a309598c71852ff.poster.avif?t=1782220777\" width=600 height=80 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/6da3fa6da80340a87a309598c71852ff.webm?t=1782220777\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/6da3fa6da80340a87a309598c71852ff.mp4?t=1782220777\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >From the individual games to choosing what song to put on the jukebox inspired by some of the great records of the early 90s, the soundtrack captures the heart of a bygone era.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/8062592fd6beba45bdcc36e0a67ab515.poster.avif?t=1782220777\" width=1170 height=374 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/8062592fd6beba45bdcc36e0a67ab515.webm?t=1782220777\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/8062592fd6beba45bdcc36e0a67ab515.mp4?t=1782220777\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/e7efa40bffed384439cb3df7ad08a0af.poster.avif?t=1782220777\" width=600 height=80 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/e7efa40bffed384439cb3df7ad08a0af.webm?t=1782220777\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/e7efa40bffed384439cb3df7ad08a0af.mp4?t=1782220777\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Hello 90’s. If you could smell this game, it would smell like memories. Everything from the look and feel of the arcades, to using the latest PC connected to the mind-blowing dial-up connection, all have been recreated with pure love. </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/71e350a51ec880d4aab50f8193fe63d6.poster.avif?t=1782220777\" width=1170 height=374 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/71e350a51ec880d4aab50f8193fe63d6.webm?t=1782220777\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/71e350a51ec880d4aab50f8193fe63d6.mp4?t=1782220777\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/fd5f6638050c86c3f0951afedca45957.poster.avif?t=1782220777\" width=600 height=80 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/fd5f6638050c86c3f0951afedca45957.webm?t=1782220777\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/fd5f6638050c86c3f0951afedca45957.mp4?t=1782220777\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Doug Cockle (famous for his voice acting in Victor Vran and The Witcher series) plays the role of Ashley’s berating father. Being too busy in the Riviera to see King Wash for himself, you will receive many phone calls from Gerald sharing his wise words of advice and constant reminders to fix the toilet.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/181f542304a4ccba7b3cf0d81b868c00.poster.avif?t=1782220777\" width=1170 height=374 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/181f542304a4ccba7b3cf0d81b868c00.webm?t=1782220777\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/extras/181f542304a4ccba7b3cf0d81b868c00.mp4?t=1782220777\" type=\"video/mp4\"></video></span></p>", "short_description": "Turn a rundown laundromat into a radical ’90s arcade. Manage your business, expand your neon empire, and balance dirty laundry with over 35 playable arcade games. Build the ultimate arcade! From the team behind Vampire Crawlers.", "supported_languages": "English<strong>*</strong>, French<strong>*</strong>, Italian, German<strong>*</strong>, Spanish - Spain, Japanese, Korean, Polish, Russian, Simplified Chinese, Traditional Chinese<br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/15945334a6ff4d8a2e2057d76c392b4a36f12c22/header.jpg?t=1782220777", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/99562ab7abb8d28ec85a4131b746a823818c52b5/capsule_231x87.jpg?t=1782220777", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388870/99562ab7abb8d28ec85a4131b746a823818c52b5/capsule_184x69.jpg?t=1782220777", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br>