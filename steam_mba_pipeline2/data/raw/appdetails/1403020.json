US SOFT"], "demos": [{"appid": 1641170, "description": "Play SCP Strategy Demo now!"}], "price_overview": {"currency": "USD", "initial": 699, "final": 699, "discount_percent": 0, "initial_formatted": "", "final_formatted": "$6.99"}, "packages": [492362], "package_groups": [{"name": "default", "title": "Buy SCP Strategy", "description": "", "selection_text": "Select a purchase option", "save_text": "", "display_type": 0, "is_recurring_subscription": "false", "subs": [{"packageid": 492362, "percent_savings_text": " ", "percent_savings": 0, "option_text": "SCP Strategy - $6.99", "option_description": "", "can_get_free_license": "0", "is_free_license": false, "price_in_cents_with_discount": 699}]}], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 22, "description": "Steam Achievements"}, {"id": 29, "description": "Steam Trading Cards"}, {"id": 30, "description": "Steam Workshop"}, {"id": 23, "description": "Steam Cloud"}, {"id": 17, "description": "Includes level editor"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "23", "description": "Indie"}, {"id": "28", "description": "Simulation"}, {"id": "2", "description": "Strategy"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1403020/ss_0d6373cf4bbd4dd4d3a00aeda0022f918d1c808c.600x338.jpg?t=1783616558", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1403020/ss_0d6373cf4bbd4dd4d3a00aeda0022f918d1c808c.1920x1080.jpg?t=1783616558"}, {"id": 1, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1403020/ss_e833c4d3ebd9be5084281eedeb1b1be2be0e868b.600x338.jpg?t=1783616558", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1403020/ss_e833c4d3ebd9be5084281eedeb1b1be2be0e868b.1920x1080.jpg?t=1783616558"}, {"id": 2, "path_thumbnail": "https://shared.akamai.steamstatic.com