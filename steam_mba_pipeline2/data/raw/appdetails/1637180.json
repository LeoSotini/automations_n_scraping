1637180/ss_e3c2da943df2ea78dfe2242e64a40ab7f2ce9508.1920x1080.jpg?t=1786541519"}], "movies": [{"id": 257159691, "name": "the Gunslinger's Oath", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257159691/6366e31f39c4c2bd7adc1ccfca3213e00ed4c82b/movie_600x337.jpg?t=1750534014", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/1637180/198416467/f4b430a2aad369ffd5f08b433a1e2636449d7de7/1750530872/dash_av1.mpd?t=1750534014", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/1637180/198416467/f4b430a2aad369ffd5f08b433a1e2636449d7de7/1750530872/dash_h264.mpd?t=1750534014", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/1637180/198416467/f4b430a2aad369ffd5f08b433a1e2636449d7de7/1750530872/hls_264_master.m3u8?t=1750534014", "highlight": true}], "release_date": {"coming_soon": true, "date": "To be announced"}, "support_info": {"url": "http://saffronstreams.com/", "email": "hello@saffronstreams.com"}, "background": "https://store.akamai.steamstatic.com/images/storepagebackground/app/1637180?t=1786541519", "background_raw": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1637180/page_bg_raw.jpg?t=1786541519", "content_descriptors": {"ids": [2, 5], "notes": "Yesterdreamt features cosmic horror and body horror, though rendered in a hand-drawn, comic book style."}, "ratings": {"dejus": {"rating_generated": "1", "rating": "14", "required_age": "14", "banned": "0", "use_age_gate": "0", "descriptors": "Violência\nMedo\nLinguagem imprópria"}, "steam_germany": {"rating_generated": "1", "rating": "16", "required_age": "16", "banned": "0", "use_age_gate": "0", "descriptors": "Horror\nSchimpfwörte"}, "igrs": {"rating_generated": "1", "rating": "18", "required_age": "18", "banned": "0", "use_age_gate": "0", "descriptors": "Horor\nKekerasan\nPenggunaan bahasa"}}}}}