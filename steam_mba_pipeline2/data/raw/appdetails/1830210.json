c4d5df51e.poster.avif?t=1772820576\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830210/extras/a6673dc0a543b0d75b934c8c4d5df51e.webm?t=1772820576\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830210/extras/a6673dc0a543b0d75b934c8c4d5df51e.mp4?t=1772820576\" type=\"video/mp4\"></video></span><br><br>And yet the Entangled One must slay to survive...<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830210/extras/cc1848f93f02df46cd31bbaab0501f87.poster.avif?t=1772820576\" width=480 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830210/extras/cc1848f93f02df46cd31bbaab0501f87.webm?t=1772820576\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1830210/extras/cc1848f93f02df46cd31bbaab0501f87.mp4?t=1772820576\" type=\"video/mp4\"></video></span><br><br>Motivated by survival. Pulled ever forward by something beyond understanding. The Entangled One must slay the godlike Primordials to reach the source of it all: The Primordial Mass....<br><br><br><br><strong><u>Disclaimer</u></strong>: The Tribulation Entanglement is an artistic visual representation of the developer's struggle with chronic pain, health issues, and disabilities. Player's discretion is advised. <br><br><strong><u>Gameplay Features:</u></strong><br><br><ul class=\"bb_ul\"><li>Experience a strange horrific world unlike any other.<br></li><li>Overcome levels filled with challenging combat and platforming.<br></li><li>25+ insane enemy types to engage in combat.<br></li><li>Use sub-attacks to augment your playstyle.<br></li><li>Collect Primordial Hearts to expand your HP and SP bar.<br></li><li>Linear hand-crafted level design that focuses on moment-to-moment gam