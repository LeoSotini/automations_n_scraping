=1724947530\" type=\"video/mp4\"></video></span>", "short_description": "Glide, collect nuts and slap birds in this small, casual 3d adventure. Play as Walter Walnut, a gliding squirrel on a quest to find the mythical golden hazelnut.", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1877560/header.jpg?t=1724947530", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1877560/ff707d48f1cbfbe49b20a3cd07e8b3f65c9c2828/capsule_231x87.jpg?t=1724947530", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1877560/ff707d48f1cbfbe49b20a3cd07e8b3f65c9c2828/capsule_184x69.jpg?t=1724947530", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 or newer<br></li><li><strong>Processor:</strong> Intel i5-2550K, 3.4 GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 670<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Codeer"], "publishers": ["Codeer"], "price_overview": {"currency": "USD", "initial": 299, "final": 299, "discount_percent": 0, "initial_formatted": "", "final_formatted": "$2.99"}, "packages": [676031], "package_groups": [{"name": "default", "title": "Buy Walter Walnut", "description": "", "selection_text": "Select a purchase option", "save_text": "", "display_type": 0, "is_recurring_subscription": "false", "subs": [{"packageid": 676031, "percent_savings_text": " ", "percent_savings": 0, "option_text": "Walter Walnut - $2.99", "option_description": "", "can_get_free_license": "0", "is_free_license": false, "price_in_cents_with_discount": 299}]}], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"