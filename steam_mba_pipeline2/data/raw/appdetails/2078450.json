m/apps/2078450/extras/3a4583bfd770631b72dcd57f23983342.mp4?t=1781273994\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/7541de8f7f64e358b17d415ad4849b39.avif?t=1781273994\" width=1200 height=101 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/1fe0e712d898120f9bc2b5098d351fca.avif?t=1781273994\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras_big/1fe0e712d898120f9bc2b5098d351fca.webp?t=1781273994 width=1560 height=210 /></span></p><h2 class=\"bb_tag\" style=\"text-align: center\">Master advanced <strong>movement techniques </strong>and use<strong> explosive weaponry</strong> to dominate the racetrack<strong>!</strong> </h2><p class=\"bb_paragraph\" >Use different vehicle classes including buggies, tanks and helicopters - each with distinct abilities that target a variety of playstyles. Progress your vehicles to unlock cosmetics and alternative weapons that make enemies go boom!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/a53503c95e211577f47d27e90eb3bf42.poster.avif?t=1781273994\" width=1170 height=488 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/a53503c95e211577f47d27e90eb3bf42.webm?t=1781273994\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/a53503c95e211577f47d27e90eb3bf42.mp4?t=1781273994\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/66fe49bec24cec48a1a4cf5c502baabe.webp?t=1781273994\" width=1200 height=30 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/1b3c73f0308d1a452d5ce4fe690b732c.poster.avif?t=1781273994\" width=1170 height=488 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/1b3c73f0308d1a452d5ce4fe690b732c.webm?t=1781273994\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/1b3c73f0308d1a452d5ce4fe690b732c.mp4?t=1781273994\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/3abd0187b4bd91db196fbc96c8d891cd.avif?t=1781273994\" width=1181 height=141 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/ea8dd853496963c542176119dd2ca501.avif?t=1781273994\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras_big/ea8dd853496963c542176119dd2ca501.webp?t=1781273994 width=1560 height=191 /></span></p><h2 class=\"bb_tag\" style=\"text-align: center\">Use the robust Creation Mode<strong> LEVEL EDITOR </strong>to make your own maps and racetracks!</h2><p class=\"bb_paragraph\" >Use 400+ available game assets to create custom races, challenges, stunt parks, tower climbs, and anything else you can think of - the only limit is your imagination!</p><p class=\"bb_paragraph\" >You can even build things with other players in real-time:</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/476afccf1e7443547c894386203ca0dc.poster.avif?t=1781273994\" width=1170 height=488 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/476afccf1e7443547c894386203ca0dc.webm?t=1781273994\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/476afccf1e7443547c894386203ca0dc.mp4?t=1781273994\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Jump into the <strong>MEK WORKSHOP</strong> to share your own creations, or rate and download other players’ crazy kustom maps they’ve made. The Workshop is a place where community creativity can thrive</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/f08399ba0c69f3484ddbadb617560822.poster.avif?t=1781273994\" width=1170 height=488 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/f08399ba0c69f3484ddbadb617560822.webm?t=1781273994\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/f08399ba0c69f3484ddbadb617560822.mp4?t=1781273994\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/852b3ee49bb33e11cf95edf4ffe5705a.avif?t=1781273994\" width=1200 height=215 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/b48d10f80c1e4347acb359fb1fff6172.avif?t=1781273994\" width=1560 height=350 /></span></p><h2 class=\"bb_tag\" style=\"text-align: center\">Immerse yourself in the badass<strong> Warhammer 40,000 universe </strong>by joining<strong> Da Kult of Speed!</strong> </h2><p class=\"bb_paragraph\" >Slap on different kits, rims, tires, accessories, and paint jobs for your war-torn wagons. The game’s accurate Ork vehicles are just like the miniatures!</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/9a1ae2bf2455458bd447004a04b65776.poster.avif?t=1781273994\" width=1170 height=488 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/9a1ae2bf2455458bd447004a04b65776.webm?t=1781273994\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/9a1ae2bf2455458bd447004a04b65776.mp4?t=1781273994\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >And customize your Ork pit boss for taunting victims you krump!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/a40ae1c7661ff5e6bd1eec307dfee00f.poster.avif?t=1781273994\" width=1170 height=488 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/a40ae1c7661ff5e6bd1eec307dfee00f.webm?t=1781273994\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2078450/extras/a40ae1c7661ff5e6bd1eec307dfee00f.mp4?t=1781273994\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>WAAAAAAAAAAAAGGHHHHHHHH!!!!!</strong><br><s