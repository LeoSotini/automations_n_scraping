26a3e063d77d4.webm?t=1785361478\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2140470/extras/5b72d6915c0673ed00c26a3e063d77d4.mp4?t=1785361478\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>• Live your Life and meet Characters with unique Story´s</strong></h2><p class=\"bb_paragraph\" >Meet and befriend Pineside´s residents, each one with their own handcrafted story and questline. Make little presents or help them in their daily life to get closer and learn more about them.  </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2140470/extras/d247f837481b7a56063daf9969ae0851.poster.avif?t=1785361478\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2140470/extras/d247f837481b7a56063daf9969ae0851.webm?t=1785361478\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2140470/extras/d247f837481b7a56063daf9969ae0851.mp4?t=1785361478\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>• Get distracted by the many activities in Pineside</strong> </h2><p class=\"bb_paragraph\" >Next to building up your hotel you can easily get distracted by Pineside many activities like sidequest´s, the arcade, bug hunting, hotel gardening and much more. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2140470/extras/af3a3810c3310335d11e8d96b31d1b95.avif?t=1785361478\" width=495 height=192 /></span></p>", "short_description": "Start your new life in the small town of Pineside. Restore its abandoned Hotel from a dusty ruin into the heart of the community. Meet memorable r