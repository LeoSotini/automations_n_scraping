static.com/store_item_assets/steam/apps/2145210/extras/36fd1417a9772f174ab53e582555cbf1.mp4?t=1773698293\" type=\"video/mp4\"></video></span></p></li><li><p class=\"bb_paragraph\" ><strong>Getting lost</strong> in a world roaring at the seams, <strong>unraveling to your actions</strong><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2145210/extras/95b14019c1f191ef06f6ba06621aa8c2.poster.avif?t=1773698293\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2145210/extras/95b14019c1f191ef06f6ba06621aa8c2.webm?t=1773698293\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2145210/extras/95b14019c1f191ef06f6ba06621aa8c2.mp4?t=1773698293\" type=\"video/mp4\"></video></span></p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Observing enemy actions and <strong>learn</strong> their skills<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2145210/extras/e5528ff5861d1866a7d826d8b97dc63d.poster.avif?t=1773698293\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2145210/extras/e5528ff5861d1866a7d826d8b97dc63d.webm?t=1773698293\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2145210/extras/e5528ff5861d1866a7d826d8b97dc63d.mp4?t=1773698293\" type=\"video/mp4\"></video></span></p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Untangling <strong>bloodlines</strong> within; <strong>bring awareness</strong> to the past<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2145210/extras/ba0