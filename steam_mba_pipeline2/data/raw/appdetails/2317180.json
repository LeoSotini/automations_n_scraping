rc=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2317180/extras/d66dd2f6155ea5aff1dbb2adf31ea738.webm?t=1788208636\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2317180/extras/d66dd2f6155ea5aff1dbb2adf31ea738.mp4?t=1788208636\" type=\"video/mp4\"></video></span> </p><p class=\"bb_paragraph\" >Cube Crusaders will be continually updated and improved for a 6 month duration after launch integrating community suggestions and bug fixes. Come join our Discord to voice your feedback!</p><p class=\"bb_paragraph\" ></p>", "short_description": "Adoros is dying. A catastrophic Void Anomaly has torn open the planet’s surface, warping reality and unleashing forces no one fully understands. You are a Cube Crusader sent to crush the Anomaly, at any cost.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2317180/469479bf205d6bc540a12a00630a0903d2f33927/header.jpg?t=1788208636", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2317180/c8d5951d9de0d81e4a54bed3b4d104dea3c21e44/capsule_231x87.jpg?t=1788208636", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2317180/c8d5951d9de0d81e4a54bed3b4d104dea3c21e44/capsule_184x69.jpg?t=1788208636", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> 10<br></li><li><strong>Processor:</strong> Quad-core Intel or AMD, 2.5 GHz or faster<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce 470 GTX or AMD Radeon 6870 HD series or higher<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 15 GB available space</li></ul>", "recommended": "