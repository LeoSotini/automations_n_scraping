/apps/2366060/extras/2af6bce6c3a3ef095cebc93b32a2fc8d.poster.avif?t=1787131684\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/2af6bce6c3a3ef095cebc93b32a2fc8d.webm?t=1787131684\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/2af6bce6c3a3ef095cebc93b32a2fc8d.mp4?t=1787131684\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/4500b18a08c1103da150cdd57e035eba.avif?t=1787131684\" width=600 height=136 /></span></p><p class=\"bb_paragraph\" >Take your Weyrdlet for a spin in <strong>Worble</strong>, a fun and chaotic mini-game where rolling through obstacle courses is half the fun. Play solo or with friends in weekly races with a fresh map every week. See who tumbles, rolls, or somehow makes it to the finish line first!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/9a13b7708ccc37ce166df8db90655f5d.poster.avif?t=1787131684\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/9a13b7708ccc37ce166df8db90655f5d.webm?t=1787131684\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/9a13b7708ccc37ce166df8db90655f5d.mp4?t=1787131684\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/caaf16136ff1066540fa5beb64dd39b9.avif?t=1787131684\" width=600 height=136 /></span></p><p class=\"bb_paragraph\" >Get your Weyrdlet ready for <strong>Sports Day</strong> and watch them learn new skills. Turn the produce and fish you’ve gathered into energizing juices that give your pet a chance to pick up new abilities. Take on Sports Day challenges to earn seeds, grow more produce, and keep the training going!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/5d90c9ef3119448b26e858dce81bc1d2.poster.avif?t=1787131684\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/5d90c9ef3119448b26e858dce81bc1d2.webm?t=1787131684\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/5d90c9ef3119448b26e858dce81bc1d2.mp4?t=1787131684\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/9cfc713c5857ecfd1bb551f75b6f84b8.avif?t=1787131684\" width=600 height=136 /></span></p><p class=\"bb_paragraph\" >Use the Pomodoro timer, track your wellness, and manage tasks with the to-do list! All available both in-game and on your desktop.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/cc8854931ed4a74f9912ef007f7bc380.poster.avif?t=1787131684\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/cc8854931ed4a74f9912ef007f7bc380.webm?t=1787131684\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/cc8854931ed4a74f9912ef007f7bc380.mp4?t=1787131684\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/44e6372089bb555f79e88be570cdac55.avif?t=1787131684\" width=600 height=136 /></span></p><p class=\"bb_paragraph\" >Let your pet idly dig for loot on your desktop or on the island while you're busy. Unlock fancy hats, home decorations, and snacks to keep your pet happy. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/41b98301ca83c81e4daaabb0a2da80d0.poster.avif?t=1787131684\" width=600 height=600 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/41b98301ca83c81e4daaabb0a2da80d0.webm?t=1787131684\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/extras/41b98301ca83c81e4daaabb0a2da80d0.mp4?t=1787131684\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "short_description": "Work with your pet on the desktop, play with your friends in-game! Weyrdlets is a desktop pet game that blends productivity and play! Customize your pets and homes, hang out with friends, enjoy minigames, and let your pets keep you company on your desktop while you work or study through the day!", "supported_languages": "English, Japanese, Korean, Simplified Chinese", "reviews": "“The casual Pokémon management sim I've always dreamed of.”<br>VideoGamer<br><br>“It’s a neat mix of much-needed wholesome distraction and actual real-life utility that I can’t help but be drawn to.”<br>RockPaperShotgun<br><br>“Weyrdlets is the virtual desktop companion you didn't know you needed.”<br>Eurogamer<br>", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/609767c3d0ce64070fce8306948e72cd7b5390d7/header.jpg?t=1787131684", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/ca9dff8eabed55b6ee7da23eed8ba619218c2782/capsule_231x87.jpg?t=1787131684", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2366060/ca9dff8eabed55b6ee7da23eed8ba619218c2782/capsule_184x69.jpg?t=1787131684", "website": "https://weyrdlets.com", "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10<br></li><li><strong>Processor:</strong> Intel Core i3 / AMD Ryzen 3<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 960 / AMD Radeon R9 380<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 11<br></li><li><strong>Processor:</strong> Intel Core i7 / AMD Ryzen 7<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Nvidia GeForce RTX 3060 6GB / AMD Radeon RX 6600<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"}, "mac_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires an Apple processor<br></li><li><strong>OS:</strong> 13.2<br></li><li><strong>Processor:</strong> M1</li></ul>"}, "linux_requirements": [], "developers": ["Weyrdworks"], "publishers": ["Weyrdworks"], "price_overview": {"currency": "USD", "initial": 699, "final": 699, "discount_percent": 0, "initial_formatted": "", "final_formatted": "$6.99"}, "packages": [1531825], 