fdec2f6939.webm?t=1786105945\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2508170/extras/1028c213b50f15c049e894fdec2f6939.mp4?t=1786105945\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" ><strong>BUILD TOGETHER</strong></h2><br>Building doesn't end with one house. Streets appear beyond the house, town squares beyond the streets. Cities stretch all the way to the horizon. Team up with other players, start communities and build large-scale projects together: places from movies and your favorite games, and whole virtual cities.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2508170/extras/4462ee0c6e685bd0315bd77b823bc6f7.poster.avif?t=1786105945\" width=780 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2508170/extras/4462ee0c6e685bd0315bd77b823bc6f7.webm?t=1786105945\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2508170/extras/4462ee0c6e685bd0315bd77b823bc6f7.mp4?t=1786105945\" type=\"video/mp4\"></video></span>", "short_description": "Build your own photorealistic home: from a modern villa to a medieval castle. Watch movies in your home, play mini-games, meet up with friends and play board games. Earn resources through in-game activities and join forces with other players to build virtual cities and entire worlds.", "supported_languages": "English, French, Italian, German, Spanish - Spain, Czech, Japanese, Korean, Polish, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese, Spanish - Latin America, Turkish, Ukrainian, Bulgarian, Danish, Dutch, Finnish, Greek, Hungarian, Indonesian, Norwegian, Romanian, Swedish, Thai, Traditional Chinese, Vietnamese", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2508170