/apps/2589050/extras/b86225ea682bba5160969678709170be.mp4?t=1779124836\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Bring these unseen materials back to the home planet for further research.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/17a7824026b8a85957ab35d584477a31.poster.avif?t=1779124836\" width=480 height=268 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/17a7824026b8a85957ab35d584477a31.webm?t=1779124836\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/17a7824026b8a85957ab35d584477a31.mp4?t=1779124836\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/f5d5e23ed0b87a6fd1ff7a22b971f96f.poster.avif?t=1779124836\" width=480 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/f5d5e23ed0b87a6fd1ff7a22b971f96f.webm?t=1779124836\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/f5d5e23ed0b87a6fd1ff7a22b971f96f.mp4?t=1779124836\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Dispatch excavation fleets across generations, using increasingly advanced technologies to break through the Void.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/defa555bfc5c28c8cabf38c85cb72904.poster.avif?t=1779124836\" width=320 height=288 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/defa555bfc5c28c8cabf38c85cb72904.webm?t=1779124836\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/defa555bfc5c28c8cabf38c85cb72904.mp4?t=1779124836\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >A short (1-2 hr) narrative-driven incremental game</p></li><li><p class=\"bb_paragraph\" >Stamina-based mining gameplay inspired by Minesweeper</p></li><li><p class=\"bb_paragraph\" >A story told through the game mechanics</p></li><li><p class=\"bb_paragraph\" >Cool ray-traced lighting! Don't worry it can run on (almost) all computers, won’t melt your system, and maintains 90 FPS on Steam Deck!</p></li></ul>", "about_the_game": "<p class=\"bb_paragraph\" >In a distant future where humanity has endured every imaginable ordeal...</p><p class=\"bb_paragraph\" >Now comes the Heat Death.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Embark on a long journey to escape the ultimate fate of humanity.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Explore the Ultra Void, a black hole like celestial body that remained undiscovered throughout human history.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/6bb7835c1c0472763c05543e3381c16b.poster.avif?t=1779124836\" width=480 height=264 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/6bb7835c1c0472763c05543e3381c16b.webm?t=1779124836\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/6bb7835c1c0472763c05543e3381c16b.mp4?t=1779124836\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Dig through its crust and gather rare resources within.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/b86225ea682bba5160969678709170be.poster.avif?t=1779124836\" width=320 height=288 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/b86225ea682bba5160969678709170be.webm?t=1779124836\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/b86225ea682bba5160969678709170be.mp4?t=1779124836\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Bring these unseen materials back to the home planet for further research.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/17a7824026b8a85957ab35d584477a31.poster.avif?t=1779124836\" width=480 height=268 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/17a7824026b8a85957ab35d584477a31.webm?t=1779124836\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/17a7824026b8a85957ab35d584477a31.mp4?t=1779124836\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2589050/extras/f5d5e23ed0b87a6fd1ff7a22b971f96f.poster.avif?t=1779124836\" width=480 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_ite