240/extras/98e3af335a4b652a6eafa3ad97dffe42.mp4?t=1762304621\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/36933f633e574f9bfd162def45926f33.poster.avif?t=1762304621\" width=600 height=50 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/36933f633e574f9bfd162def45926f33.webm?t=1762304621\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/36933f633e574f9bfd162def45926f33.mp4?t=1762304621\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Find and collect items necessary for exploration, and acquire new tools with gold. <br>Sell unnecessary items to secure more resources. <br>The right choice will illuminate the path of survival like a light in the darkness! </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/dded2fdb893fde28cef0f922a580fab5.poster.avif?t=1762304621\" width=544 height=306 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/dded2fdb893fde28cef0f922a580fab5.webm?t=1762304621\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/dded2fdb893fde28cef0f922a580fab5.mp4?t=1762304621\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/d293102901b6566498d573ed504b6035.poster.avif?t=1762304621\" width=600 height=50 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/d293102901b6566498d573ed504b6035.webm?t=1762304621\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/d293102901b6566498d573ed504b6035.mp4?t=1762304621\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Creature research is a guide to survival. Observe and record their behavior patterns. This will be the key to overcoming threats and completing your mission, like reading stars in a storm. </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/2258df8c259f701de0b07f2552c3a437.poster.avif?t=1762304621\" width=544 height=306 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/2258df8c259f701de0b07f2552c3a437.webm?t=1762304621\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/extras/2258df8c259f701de0b07f2552c3a437.mp4?t=1762304621\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>", "short_description": "Spectral Scream is a 1-4 player cooperative horror exploration game. Are you ready to face death in the maw of purgatory? Your goal is to find key items in each chapter and retrieve the orb. But be careful! Threatening and vicious creatures await you at every stage.", "supported_languages": "English, Korean, German, Spanish - Spain, Japanese, Simplified Chinese, Traditional Chinese, French, Greek, Dutch, Russian, Portuguese - Brazil, Portuguese - Portugal, Finnish", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2620240/82b2f69c65e023bdc4b6b70a3b6de4ef574b2992/header.jpg?t=1762304621", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/stea