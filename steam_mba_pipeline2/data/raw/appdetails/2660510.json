nch, German, Spanish - Spain, Portuguese - Brazil, Simplified Chinese, Japanese, Korean", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2660510/529bffbac77f2df1d3de144c7ba949cf41fd4c2d/header.jpg?t=1788221671", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2660510/eded4987e16401ad9a70684e1ba0161c2567e9f8/capsule_231x87.jpg?t=1788221671", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2660510/eded4987e16401ad9a70684e1ba0161c2567e9f8/capsule_184x69.jpg?t=1788221671", "website": "https://octopinbs.com", "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows10<br></li><li><strong>Processor:</strong> Intel Core i5-7400 CPU @ 3.00GHz/7世代<br></li><li><strong>Memory:</strong> 8000 MB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 1050TI<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows10<br></li><li><strong>Processor:</strong> Intel Core i5-8600K<br></li><li><strong>Memory:</strong> 8000 MB RAM<br></li><li><strong>Graphics:</strong> NVidia GTX 1070<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"}, "mac_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"}, "linux_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>", "recommended": "<strong>Recommended:</strong><br><