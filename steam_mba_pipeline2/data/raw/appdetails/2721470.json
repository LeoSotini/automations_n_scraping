21d1b.poster.avif?t=1760348762\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721470/extras/8ab54bd4e56f5bca4cd59ed732121d1b.webm?t=1760348762\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721470/extras/8ab54bd4e56f5bca4cd59ed732121d1b.mp4?t=1760348762\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >🔫ARMED AND READY🎽</h2> ⭐ Enhance your skills by utilizing upgrade coins that can be found during missions.<br>⭐ Heroic story – Unravel the secrets behind CyberCorp's experiments with your mysterious companion.<br>⭐ CyberCorp`s thugs &amp; Bugs – Varied enemies, including humanoid adversaries and creatures born of digital corruption.<br>⭐ Variety of weapons – From the Pistol &amp; Shotgun to the Rocket Launcher and Plasma Cannon (with alternative firing mods).<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721470/extras/d0be1cf55d4f2e476c3c3d76db876897.poster.avif?t=1760348762\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721470/extras/d0be1cf55d4f2e476c3c3d76db876897.webm?t=1760348762\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721470/extras/d0be1cf55d4f2e476c3c3d76db876897.mp4?t=1760348762\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721470/extras/51073e43d40207a2df15f7dd5500d823.poster.avif?t=1760348762\" width=600 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721470/extras/51073e43d40207a2df15f7dd5500d823.webm?t=1760348762\" type=\"video/webm; codecs=vp9\"><source src=\"https://sha