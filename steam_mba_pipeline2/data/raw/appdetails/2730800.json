pps/2730800/2be49eb73868b7ad2f944d09c4d6a370c11dc07f/ss_2be49eb73868b7ad2f944d09c4d6a370c11dc07f.600x338.jpg?t=1776951507", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/2be49eb73868b7ad2f944d09c4d6a370c11dc07f/ss_2be49eb73868b7ad2f944d09c4d6a370c11dc07f.1920x1080.jpg?t=1776951507"}, {"id": 3, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/22e6bb4615af18ebf94b9db675448f35947e2b16/ss_22e6bb4615af18ebf94b9db675448f35947e2b16.600x338.jpg?t=1776951507", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/22e6bb4615af18ebf94b9db675448f35947e2b16/ss_22e6bb4615af18ebf94b9db675448f35947e2b16.1920x1080.jpg?t=1776951507"}, {"id": 4, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/a1fc79f05664b05d4c6c43e5070825edbc4b6c0d/ss_a1fc79f05664b05d4c6c43e5070825edbc4b6c0d.600x338.jpg?t=1776951507", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/a1fc79f05664b05d4c6c43e5070825edbc4b6c0d/ss_a1fc79f05664b05d4c6c43e5070825edbc4b6c0d.1920x1080.jpg?t=1776951507"}, {"id": 5, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/7929a94f680f55b22981d75f7f0c6b80b5d47c03/ss_7929a94f680f55b22981d75f7f0c6b80b5d47c03.600x338.jpg?t=1776951507", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/7929a94f680f55b22981d75f7f0c6b80b5d47c03/ss_7929a94f680f55b22981d75f7f0c6b80b5d47c03.1920x1080.jpg?t=1776951507"}, {"id": 6, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/333439ff68399ef2e9c627598f264b6f0206eb58/ss_333439ff68399ef2e9c627598f264b6f0206eb58.600x338.jpg?t=1776951507", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2730800/333439ff68399ef2e9c627598f264b6f0206eb58/ss_333439ff68399ef2e9c627598f264b6f0206eb58.1920x1080.jpg?t=177695