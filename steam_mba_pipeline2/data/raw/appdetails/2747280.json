/apps/2747280/extras/df5266694b9307ec05dc30f0483db259.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/df5266694b9307ec05dc30f0483db259.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/ca8f01733c8e7b122b618ad9e9847913.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/ca8f01733c8e7b122b618ad9e9847913.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >---------------------------------</p><h2 class=\"bb_tag\" ><strong>The Things That Hunt You Back</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Every realm has its own apex predator - and they remember you</p></li><li><p class=\"bb_paragraph\" >Some are corrupted. Some are ancient. Some are both.</p></li><li><p class=\"bb_paragraph\" >A few can be avoided. Most cannot.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/0392ffdc7feb9fa8eba3b9b9cb5b9f85.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/0392ffdc7feb9fa8eba3b9b9cb5b9f85.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/0af3c93d48d3ce4be983efc8a2407c5e.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/0af3c93d48d3ce4be983efc8a2407c5e.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/5bebd3e5691f6705bcf5e134ea24dc45.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/5bebd3e5691f6705bcf5e134ea24dc45.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/abcc4ad4e7b78511b2300f202f8cd150.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/abcc4ad4e7b78511b2300f202f8cd150.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/dd5170045ae17119a167b14f4316e3e0.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/dd5170045ae17119a167b14f4316e3e0.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >---------------------------------</p><h2 class=\"bb_tag\" ><strong>You Can't Fight What You're Not Prepared For</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Resources run out. Enemies don't.</p></li><li><p class=\"bb_paragraph\" >Mine deeper. Craft smarter. Descend further.</p></li><li><p class=\"bb_paragraph\" >The Abyss doesn't wait for you to be ready.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/d8cb9f0f4d06d1c77db99c191e68929e.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/d8cb9f0f4d06d1c77db99c191e68929e.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/47dfb9b2c3fd1c9ec9987de76b375abf.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/47dfb9b2c3fd1c9ec9987de76b375abf.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >---------------------------------</p><h2 class=\"bb_tag\" ><strong>Build Something Worth Coming Back To</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Craft gear, cook meals, forge weapons</p></li><li><p class=\"bb_paragraph\" >Decorate your own space between descents</p></li><li><p class=\"bb_paragraph\" >Your shelter is the only safe place left</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/ea6f89d064979d7cd1b23ed00af17df8.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/ea6f89d064979d7cd1b23ed00af17df8.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/69adb4b3b74415ee66c909f015e47417.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/69adb4b3b74415ee66c909f015e47417.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >---------------------------------</p><h2 class=\"bb_tag\" ><strong>Not Everything Down Here Wants to Kill You</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Farm. Fish. Breathe.</p></li><li><p class=\"bb_paragraph\" >Peaceful moments exist - right before the next world tries to end you.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/9f14bb92aa79322da1d63a5d5a8a718e.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/9f14bb92aa79322da1d63a5d5a8a718e.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/18668a8f797f433feb9a5fe21e90d4e1.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/18668a8f797f433feb9a5fe21e90d4e1.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >---------------------------------</p><h2 class=\"bb_tag\" ><strong>Tame Beasts. Ride Legends.</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Some creatures can be tamed - if you're patient enough</p></li><li><p class=\"bb_paragraph\" >Mounts don't just carry you. They change how you move through the world.</p></li><li><p class=\"bb_paragraph\" >A T-Rex at your side hits different.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/64c4369bc739b9d32159fc21c7391c4a.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/64c4369bc739b9d32159fc21c7391c4a.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/84b6ebf03ccc8fddfcefe27b9a67634f.poster.avif?t=1776345519\" width=620 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/extras/84b6ebf03ccc8fddfcefe27b9a67634f.webm?t=1776345519\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" >---------------------------------</p><h2 class=\"bb_tag\" ><strong>Your Abyss. Your Rules.</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Customize your character before the descent</p></li><li><p class=\"bb_paragraph\" >No two playthroughs look the same</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2747280/e