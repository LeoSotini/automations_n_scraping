34630/extras/2cfd609105329a3974c369fd2289715a.webm?t=1787230500\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2834630/extras/2cfd609105329a3974c369fd2289715a.mp4?t=1787230500\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>Freeroam Afrofuturistic Biomes</strong><br>Discover vast, living regions filled with side quests, rare resources, exotic creatures, and opportunities to trade, hunt, and build your reputation.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2834630/extras/951c2975c13d8c88533736d48a9d0267.poster.avif?t=1787230500\" width=1170 height=878 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2834630/extras/951c2975c13d8c88533736d48a9d0267.webm?t=1787230500\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2834630/extras/951c2975c13d8c88533736d48a9d0267.mp4?t=1787230500\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" ></p>", "short_description": "Unyverse is an Afrofuturistic RPG With Fighting Game Mechanics Where Your Fists, Choices, and Inner Power Change the Fate of a Galaxy.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2834630/c7589b1c18af72bfc3c595691519e068ddf5423e/header.jpg?t=1787230500", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2834630/4644ce6e9aa653d2f34a5fd59dab02dc762b8ef0/capsule_231x87.jpg?t=1787230500", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2834630/