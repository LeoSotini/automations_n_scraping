2387e7aa31083eeeffd.webm?t=1769640682\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/extras/e2d9681655bdd2387e7aa31083eeeffd.mp4?t=1769640682\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Explore unique worlds full of challenge and opportunity, expanding as you bond with new Dwellers: Tear through rocks, levitate through air, activate ancient elemental runes, and more. Seek out powerful bosses across the fallen worlds and defeat them to gain their power.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Battle your foes in turn-based encounters. Survival demands cunning and skill, as everything matters: Environment, type, alignment, and even place in the roster. Ambush your foes, choose the battlefield - or risk everything in dangerous gambits!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Strategize your path across Kohara. Opportunities to heal are few, Dwellers plentiful, the risk great. Each battle is an opportunity - but also risks leaving you unprepared for the dangers ahead. Feeling confident? The optional permadeath mode raises the stakes even further.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/extras/80a39070bb68d3564bfb4e83630a528a.avif?t=1769640682\" width=780 height=85 /></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/extras/56cceac3e2589912cf284f1f0f0f93ea.poster.avif?t=1769640682\" width=780 height=316 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/extras/56cceac3e2589912cf284f1f0f0f93ea.webm?t=1769640682\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/extras/56cceac3e2589912cf284f1f0f0f93ea.mp4?t=1769640682\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >From the lush forests and idyllic villages of the heartland, through the harsh deserts and ruins of Vinor, to the holy capital in the Skyworld and beyond, each of the Nine Worlds that make up Kohara is unique.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Beyond visuals, each world's struggle is unique. As nations crumble and Dwellers rampage unchecked, the Great Link redraws the balance of power, pushing humanity into either its finest hour or the very last moments.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >You will choose which one it'll be, as you experience a complex story exploring the impact of such a cataclysm on humanity. As famine and war spread unchecked, there are no heroes or villains, only people pushed beyond their limits. Who will you be?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/extras/ed6e4e632924d6cbe31a8677bdc2ff21.poster.avif?t=1769640682\" width=780 height=316 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/extras/ed6e4e632924d6cbe31a8677bdc2ff21.webm?t=1769640682\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/extras/ed6e4e632924d6cbe31a8677bdc2ff21.mp4?t=1769640682\" type=\"video/mp4\"></video></span></p>", "short_description": "Dwellink is a dark fantasy creature collector RPG, set in a universe under siege. The Great Link opened portals connecting the Nine Worlds of Kohara, allowing ferocious Dwellers to spread chaos and destruction. It's up to you to discover the source of the cataclysm and end it once and for all!", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/header.jpg?t=1769640682", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/capsule_231x87.jpg?t=1769640682", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/capsule_184x69.jpg?t=1769640682", "website": "https://highpassionstudios.com/", "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> Intel-Core i5-10400/i7-6800k<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce RTX 2060<br></li><li><strong>Storage:</strong> 70 GB available space<br></li><li><strong>Additional Notes:</strong> SSD required</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> Intel i5-10600K<br></li><li><strong>Memory:</strong> 32 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce 3060ti/3070<br></li><li><strong>Storage:</strong> 70 GB available space<br></li><li><strong>Additional Notes:</strong> SSD required</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "legal_notice": "© HighPassionStudios & Freedom Games - All Rights Reserved", "developers": ["HighPassionStudios"], "publishers": ["indie.io"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 18, "description": "Partial Controller Support"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "1", "description": "Action"}, {"id": "3", "description": "RPG"}, {"id": "2", "description": "Strategy"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927490/ss_685c3ed595624bd526c125f15aaa3e0551f76761.600x338.jpg?t=1769640682", "path_full": "ht