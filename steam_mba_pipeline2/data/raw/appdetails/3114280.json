ers/3114280/682513233/f0ca85528d8b0de894df9bb742b6d664e471ebee/1751869681/dash_av1.mpd?t=1756777650", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/3114280/682513233/f0ca85528d8b0de894df9bb742b6d664e471ebee/1751869681/dash_h264.mpd?t=1756777650", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/3114280/682513233/f0ca85528d8b0de894df9bb742b6d664e471ebee/1751869681/hls_264_master.m3u8?t=1756777650", "highlight": true}], "release_date": {"coming_soon": false, "date": "Oct 11, 2025"}, "support_info": {"url": "https://www.hoondahl.com", "email": "hoondahl@hoondahl.com"}, "background": "https://store.akamai.steamstatic.com/images/storepagebackground/app/3114280?t=1760257399", "background_raw": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3114280/3578321fb3e432d11f15697ecd6829d005402710/page_bg_raw.jpg?t=1760257399", "content_descriptors": {"ids": [], "notes": null}, "ratings": {"dejus": {"rating_generated": "1", "rating": "14", "required_age": "14", "banned": "0", "use_age_gate": "0", "descriptors": "Linguagem imprópria\nAtos criminosos\nMedo"}, "steam_germany": {"rating_generated": "1", "rating": "12", "required_age": "12", "banned": "0", "use_age_gate": "0", "descriptors": "Gewalt\nAlkohol / Tabak\nDerbe Sprache"}, "igrs": {"rating_generated": "1", "rating": "18", "required_age": "18", "banned": "0", "use_age_gate": "0", "descriptors": "Horor\nRokok dan/atau rokok elektronik, minuman beralkohol, narkotika, psikotropika, dan/atau zat adiktif lainnya\nPenggunaan bahasa"}}}}}