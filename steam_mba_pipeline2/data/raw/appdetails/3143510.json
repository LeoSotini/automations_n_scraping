d.akamai.steamstatic.com/store_item_assets/steam/apps/257084467/ac1a73e84e170a81375af502fccf6c9e4b69e0bc/movie_600x337.jpg?t=1786679254", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/3143510/803977/232c0e2811f190d15f7e3c93f8f2ebcf16ca3881/1750874574/dash_av1.mpd?t=1786679254", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/3143510/803977/232c0e2811f190d15f7e3c93f8f2ebcf16ca3881/1750874574/dash_h264.mpd?t=1786679254", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/3143510/803977/232c0e2811f190d15f7e3c93f8f2ebcf16ca3881/1750874574/hls_264_master.m3u8?t=1786679254", "highlight": true}], "release_date": {"coming_soon": true, "date": "To be announced"}, "support_info": {"url": "", "email": "2281202812@qq.com"}, "background": "https://store.akamai.steamstatic.com/images/storepagebackground/app/3143510?t=1787116564", "background_raw": "https://store.akamai.steamstatic.com/images/storepagebackground/app/3143510?t=1787116564", "content_descriptors": {"ids": [], "notes": null}, "ratings": {"cadpa": {"rating": "12", "descriptors": "（1）本游戏是一款快节奏的第一人称射击游戏，适用于年满12周岁及以上的用户，建议未成年人在监护人的指导下使用本产品。\n\n（2）本游戏以架空的科幻世界为背景，讲述玩家使用各类武器抵御入侵现实世界的像素怪物、守护世界的故事。游戏中的角色、场景、怪物及事件均为虚构内容，不涉及真实历史、现实人物或现实事件。\n\n（3）游戏主要包含射击、爆破、环境破坏、探索、角色成长和战术搭配等玩法。玩家可使用枪械、技能及特殊插件攻击像素怪物，并通过破坏墙壁、掩体、地面等场景元素改变战斗路线、探索隐藏区域。游戏中的战斗表现采用风格化的3D像素破碎效果，不包含血腥、恐怖、残肢等不适宜未成年人的写实化内容。\n\n（4）游戏中的敌人为虚构的像素怪物，拥有不同的攻击方式和战斗机制。玩家需要观察敌人弱点、合理搭配武器与强化效果，并通过操作、反应和策略完成关卡挑战。游戏整体氛围紧张爽快、积极向上，有助于培养玩家的反应能力、空间判断能力和策略思考能力。\n\n（5）根据国家新闻出版署发布的《关于防止未成年人沉迷网络游戏的通知》和《关于进一步严格管理切实防止未成年人沉迷网络游戏的通知》，游戏中有用户实名认证系统，认证为未成年人的用户将接受以下管理：\n认证为未成年人的用户可在周五、周六、周日和法定节假日每日20时至21时登录游戏，其他时间无法登录游戏。"}, "dejus": {"rating_generated": "1", "rating": "l", "required_age": "0", "banned": "0", "use_age_gate": "0", "descriptors": ""}, "steam_germany": {"rating_generated": "1", "rating": "0", "required_age": "0", "banned": "0", "use_age_gate": "0", "descriptors": ""}, "igrs": {"rating_generated": "1", "rating": "3", "required_age": "0", "b