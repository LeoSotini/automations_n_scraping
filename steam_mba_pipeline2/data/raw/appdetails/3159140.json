{"3159140": {"success": true, "data": {"type": "game", "name": "Cat City: A story About Dreams", "steam_appid": 3159140, "required_age": 0, "is_free": false, "detailed_description": "<p class=\"bb_paragraph\" >Welcome to Cat City, where Throy’s story takes place, a dreamless yellow cat whose self-discovery journey you’ll follow throughout the game as he tries to find a dream to pursue!</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Cat City: A Story About Dreams is a modern Point N’ Click game with Visual Novel elements. It’s a calm, relaxing and cheerful experience, perfect for those who wish to step away from reality but are not into the popular and extremely frenetic games from nowadays. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Besides the usual Point N’ Click mechanics, you’ll also find: </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Places to explore</p></li><li><p class=\"bb_paragraph\" >Hidden items</p></li><li><p class=\"bb_paragraph\" >Minigames throughout your journey</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Cat City will soon come out to PC and mobile devices.</p>", "about_the_game": "<p class=\"bb_paragraph\" >Welcome to Cat City, where Throy’s story takes place, a dreamless yellow cat whose self-discovery journey you’ll follow throughout the game as he tries to find a dream to pursue!</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Cat City: A Story About Dreams is a modern Point N’ Click game with Visual Novel elements. It’s a calm, relaxing and cheerful experience, perfect for those who wish to step away from reality but are not into the popular and extremely frenetic games from nowadays. </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Besides the usual Point N’ Click mechanics, you’ll also find: </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Places to explore</p></li><li><p class=\"bb_paragraph\" >Hidden items</p></li><li><p class=\"bb_paragraph\" >Minigames throughout your journey</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Cat City will soon come out to PC and mobile devices.</p>", "short_description": "Cat City: A Story About Dreams is a modern Point N’ Click with Visual Novel elements. The game tells the story of Throy, a dreamless yellow cat who you’ll follow on a self-discovery journey as he tries to find a dream for himself!", "supported_languages": "English, Portuguese - Brazil, French, Spanish - Latin America", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3159140/584539c0f08aa621cd70faca7afe7da8305d5461/header.jpg?t=1771130343", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3159140/0634ad4911ef109adab85fe11cd2bed848018c0f/capsule_231x87.jpg?t=1771130343", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3159140/0634ad4911ef109adab85fe11cd2bed848018c0f/capsule_184x69.jpg?t=1771130343", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 or better<br></li><li><strong>Processor:</strong> Intel Core I3 or better<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Not necessary<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 or better<br></li><li><strong>Processor:</strong> Intel Core I7-6700 or better<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> NIVIDIA GeForce GTX 970 or better<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Instal Entretenimento"], "publishers": ["Instal Entretenimento"], "demos": [{"appid": 3159910, "description": ""}], "package_groups": [], "platforms": {"windows": t