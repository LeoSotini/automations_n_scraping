130/3f560bbaa5a1b72a24b72d0fb78ed5266143bf9a/ss_3f560bbaa5a1b72a24b72d0fb78ed5266143bf9a.600x338.jpg?t=1778321186", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170130/3f560bbaa5a1b72a24b72d0fb78ed5266143bf9a/ss_3f560bbaa5a1b72a24b72d0fb78ed5266143bf9a.1920x1080.jpg?t=1778321186"}, {"id": 8, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170130/32ba35bce2e50e2a09a410c3544617afad045f49/ss_32ba35bce2e50e2a09a410c3544617afad045f49.600x338.jpg?t=1778321186", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170130/32ba35bce2e50e2a09a410c3544617afad045f49/ss_32ba35bce2e50e2a09a410c3544617afad045f49.1920x1080.jpg?t=1778321186"}, {"id": 9, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170130/0ee332dfa369ee90e4f6217d3f22d3aaf33acf9b/ss_0ee332dfa369ee90e4f6217d3f22d3aaf33acf9b.600x338.jpg?t=1778321186", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170130/0ee332dfa369ee90e4f6217d3f22d3aaf33acf9b/ss_0ee332dfa369ee90e4f6217d3f22d3aaf33acf9b.1920x1080.jpg?t=1778321186"}, {"id": 10, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170130/eb26756d24ba3b48b1e98fdeda6ec0250fda906c/ss_eb26756d24ba3b48b1e98fdeda6ec0250fda906c.600x338.jpg?t=1778321186", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3170130/eb26756d24ba3b48b1e98fdeda6ec0250fda906c/ss_eb26756d24ba3b48b1e98fdeda6ec0250fda906c.1920x1080.jpg?t=1778321186"}], "movies": [{"id": 257136620, "name": "Gameplay Trailer", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257136620/f7eacd3ffb922910ac5cb2526fdcbba55b7e2091/movie_600x337.jpg?t=1778174436", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/3170130/2019742725/31dd1ce2f359fa09f4e819220d92f240e00d5753/1778161385/dash_av1.mpd?t=1778174436", "dash_h264": "https://video.akam