38.jpg?t=1778807440", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/289c8b89b6c7496c61caa40652d836ca4de48ac4/ss_289c8b89b6c7496c61caa40652d836ca4de48ac4.1920x1080.jpg?t=1778807440"}, {"id": 4, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/a6868be62d87cbd68884764004fa78133117a1cf/ss_a6868be62d87cbd68884764004fa78133117a1cf.600x338.jpg?t=1778807440", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/a6868be62d87cbd68884764004fa78133117a1cf/ss_a6868be62d87cbd68884764004fa78133117a1cf.1920x1080.jpg?t=1778807440"}, {"id": 5, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/11ef041ac6d6d747036b87344567219e50734475/ss_11ef041ac6d6d747036b87344567219e50734475.600x338.jpg?t=1778807440", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/11ef041ac6d6d747036b87344567219e50734475/ss_11ef041ac6d6d747036b87344567219e50734475.1920x1080.jpg?t=1778807440"}, {"id": 6, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/65775127394a888559e7deba4dd60cc4756c1096/ss_65775127394a888559e7deba4dd60cc4756c1096.600x338.jpg?t=1778807440", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/65775127394a888559e7deba4dd60cc4756c1096/ss_65775127394a888559e7deba4dd60cc4756c1096.1920x1080.jpg?t=1778807440"}, {"id": 7, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/2bf237857a99bba46483a1a34e218c6a0ebdce5b/ss_2bf237857a99bba46483a1a34e218c6a0ebdce5b.600x338.jpg?t=1778807440", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3189480/2bf237857a99bba46483a1a34e218c6a0ebdce5b/ss_2bf237857a99bba46483a1a34e218c6a0ebdce5b.1920x1080.jpg?t=1778807440"}], "movies": [{"id": 257241575, "name": "Robodies Official Trailer", "thumbnail": "https://share