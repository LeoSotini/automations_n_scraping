_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3210060/extras/da3aa7634fc7235ad49c594442dc61d0.poster.avif?t=1767790082\" width=602 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3210060/extras/da3aa7634fc7235ad49c594442dc61d0.webm?t=1767790082\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3210060/extras/da3aa7634fc7235ad49c594442dc61d0.mp4?t=1767790082\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Increase Biodiversity and find new Species: </strong>Find as many different species as possible and find out how they fit into your garden’s ecosystem. Create new biomes to attract different species and exchange rare finds with the community. A journal, complete with hand-painted sketches and descriptions, helps you track your progress and expand your gardening knowledge.</p></li><li><p class=\"bb_paragraph\" ><strong>Resource Management</strong>: Manage water, energy, and other resources wisely to keep your farm thriving. Utilize renewable resources and adapt to changing conditions to create a sustainable environment.</p></li><li><p class=\"bb_paragraph\" ><strong>Companionship:</strong> Look after and befriend a cat and together, enjoy the beautiful environment you've created.</p></li></ul><p class=\"bb_paragraph\" ></p>", "short_description": "Skyfarm is a cozy single-player 3D farming simulation game, set on a post-apocalyptic rooftop and based on regenerative agriculture. Tend to your garden and create self-regulating ecosystems to harvest food and increase biodiversity. Talk to fellow rooftop gardeners and unlock new elements.", "supported_languages": "English<strong>*</strong>, French, German, Japanese, Portuguese - Brazil, Russian, Simplified Chinese, Spanish - Spain<br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3210060/4c7e5cb733ed55ac08dc3c31741f7c96ac0f7591/header.jpg?t=1767790082", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3210060/4900b60b0a5d50cb6020caea5c06c7b7eee07774/capsule_231x87.jpg?t=1767790082", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3210060/4900b60b0a5d50cb6020caea5c06c7b7eee07774/capsule_184x69.jpg?t=1767790082", "website": "https://skyfarm-game.com/", "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10, Windows 11<br></li><li><strong>Processor:</strong> TBD<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> TBD<br></li><li><strong>Storage:</strong> 10 GB available space<br></li><li><strong>Additional Notes:</strong> Requires a 64-bit processor and operating system</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10, Windows 11<br></li><li><strong>Processor:</strong> TBD<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> TBD<br></li><li><strong>Storage:</strong> 10 GB available space<br></li><li><strong>Additional Notes:</strong> Requires a 64-bit processor and operating system</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Plaid Games"], "publishers": ["Plaid Games"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "4", "description": "Casual"}, {"id": "23", "description": "Indie"}, {"id": "28", "description": "Simulation"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3210060/9be514552a17165e312088e58c27be3a64864614/ss_