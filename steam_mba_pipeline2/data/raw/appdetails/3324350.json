vp9\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/749ec9989b9d358e13fb9ce21f9c2885.poster.avif?t=1761813591\" width=1170 height=853 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/749ec9989b9d358e13fb9ce21f9c2885.webm?t=1761813591\" type=\"video/webm; codecs=vp9\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/1cac5aa956b3df091b2722f000c4d755.poster.avif?t=1761813591\" width=1170 height=853 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/1cac5aa956b3df091b2722f000c4d755.webm?t=1761813591\" type=\"video/webm; codecs=vp9\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/f99dda3ab840849340e884eeb0050792.poster.avif?t=1761813591\" width=1170 height=894 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/f99dda3ab840849340e884eeb0050792.webm?t=1761813591\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/c9372a1a2b891b8c6329a8c3c0db3f59.avif?t=1761813591\" width=600 height=329 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/f6fecc511998ad22e3d99cf2ec30a63c.avif?t=1761813591\" width=600 height=348 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/291a74185042cdab25d23fcaf8e3e99f.avif?t=1761813591\" width=600 height=325 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/b2342282b143245473530e5900ae8e12.avif?t=1761813591\" width=600 height=383 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/ed3fd4a68061b83f7067aa16173805cd.avif?t=1761813591\" width=600 height=386 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/d68cbd83bed81e50c5fdb210ff638ac7.avif?t=1761813591\" width=600 height=355 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Card Types:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Single: A single card, like an A.</p></li><li><p class=\"bb_paragraph\" >Pair: Two cards of the same rank, like KK.</p></li><li><p class=\"bb_paragraph\" >Consecutive Pairs: Two or more pairs in a row, like 33 and 44.</p></li><li><p class=\"bb_paragraph\" >Straight: Five or more consecutive single cards, like 3-4-5-6-7 (doesn’t include 2).</p></li><li><p class=\"bb_paragraph\" >Three of a Kind: Three cards of the same rank, like QQQ.</p></li><li><p class=\"bb_paragraph\" >Consecutive Threes: Two or more consecutive three-of-a-kind sets, like 333 and 444 (doesn’t include 2).</p></li><li><p class=\"bb_paragraph\" >Bomb: Four or more cards of the same rank, like 6666.</p></li><li><p class=\"bb_paragraph\" >Consecutive Bombs: Two or more consecutive sets of bombs, like 6666 and 7777.</p></li><li><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" ><strong>Attack Power Calculation:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Number cards have attack power equal to their rank. J, Q, and K are worth 10, and A is worth 11.</p></li><li><p class=\"bb_paragraph\" >Every card in a combination contributes to the total attack power.</p></li></ul><p class=\"bb_paragraph\" >Actual Attack Power = (Total Attack Power of All Cards in the Combination + Base Attack Power of the Combination) × Attack Multiplier of the Combination.</p>", "about_the_game": "<p class=\"bb_paragraph\" >Lord! Gather your hand, defeat all kinds of forces (and win their people over), and become the ruler of the Three Kingdoms! That’s your mission!</p><p class=\"bb_paragraph\" >In this game, you’ll use the cards in your deck to form specific card combinations, dealing damage to enemies!</p><p class=\"bb_paragraph\" >Once you defeat an enemy, they’ll join your ranks (and maybe even your harem)!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >🔥 <strong>Clothing Break System</strong><br>Every character comes with a Clothing Break system. As you progress through the game, characters will switch into <strong>Break 1</strong> and <strong>Break 2</strong> stages.</p><p class=\"bb_paragraph\" >Below are some preview images of the Clothing Break effects for certain characters:</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3324350/extras/013a32430f82789aedb86f3b4bdccab3.poster.avif?t=1761813591\" width=1170 height=649 