{"3436420": {"success": true, "data": {"type": "game", "name": "Keep Them Sleeping", "steam_appid": 3436420, "required_age": 0, "is_free": false, "detailed_description": "<p class=\"bb_paragraph\" >A sci-fi simulation game in which you take the role of the Emergency Pod Management Bot (EPMB) on a spaceship. The inhabitants of the medbay pods have been put into cryosleep due to the length of the journey. Somewhere along the way, disaster strikes, ripping apart the hull and disabling most of the automated systems. It is your job to keep the patients alive, healthy, and asleep.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Global Leaderboard</strong></p><p class=\"bb_paragraph\" >Do your best to place on the top 100 global leaderboard.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Local and Global Stats</strong></p><p class=\"bb_paragraph\" >The number of crew members that have lived and died is tracked for yourself as well as all of the players and displayed on the title screen. <i>The global stats are for the past 60 days and are not live stats, they updates periodically.</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Steam Friends</strong></p><p class=\"bb_paragraph\" >The default setting for the game will pull users from your Steam friends list to use as crew members.<i> This option can be disabled in the settings.</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Customize your character for your friends</strong></p><p class=\"bb_paragraph\" >In the crew manifest, if you customize your own character, then when your friends are playing they can see your customized character.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Customize your friend's characters</strong></p><p class=\"bb_paragraph\" >In the crew manifest, you can customize your friends' characters.<i> Note that this will overwrite your friends' custom characters.</i></p>", "about_the_game": "<p class=\"bb_paragraph\" >A sci-fi simulation game in which you take the role of the Emergency Pod Management Bot (EPMB) on a spaceship. The inhabitants of the medbay pods have been put into cryosleep due to the length of the journey. Somewhere along the way, disaster strikes, ripping apart the hull and disabling most of the automated systems. It is your job to keep the patients alive, healthy, and asleep.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Global Leaderboard</strong></p><p class=\"bb_paragraph\" >Do your best to place on the top 100 global leaderboard.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Local and Global Stats</strong></p><p class=\"bb_paragraph\" >The number of crew members that have lived and died is tracked for yourself as well as all of the players and displayed on the title screen. <i>The global stats are for the past 60 days and are not live stats, they updates periodically.</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Steam Friends</strong></p><p class=\"bb_paragraph\" >The default setting for the game will pull users from your Steam friends list to use as crew members.<i> This option can be disabled in the settings.</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Customize your character for your friends</strong></p><p class=\"bb_paragraph\" >In the crew manifest, if you customize your own character, then when your friends are playing they can see your customized character.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Customize your friend's characters</strong></p><p class=\"bb_paragraph\" >In the crew manifest, you can customize your friends' characters.<i> Note that this will overwrite your friends' custom characters.</i></p>", "short_description": "As an Emergency Pod Management Bot, it is your job to keep your crew alive and asleep in the case of an emergency.", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3436420/807b8ef7a05946de7e3f0576457c6ab4659c943d/header.jpg?t=1774156556", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3436420/549e6fb6057686169745a1467a886777fe033dba/capsule_231x87.jpg?t=1774156556", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3436420/549e6fb6057686169745a1467a886777fe033dba/capsule_184x69.jpg?t=1774156556", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Memory:</strong> 256 MB RAM<br></li><li><strong>DirectX:</strong> Version 10<br></li><li><strong>Storage:</strong> 41 MB available space<br></li><li><strong>Additional Notes:</strong> .NET 6</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Beals Software"], "publishers": ["Beals Software"], "price_overview": {"currency": "USD", "initial": 499, "final": 499, "discount_percent": 0, "initial_formatted": "", "final_formatted": "$4.99"}, "packages": [1214814], "package_groups": [{"name": "default", "title": "Buy Keep Them Sleeping", "description": "", "selection_text": "Select a purchase option", "save_text": "", "display_type": 0, "is_recurring_subscription": "false", "subs": [{"packageid": 1214814, "percent_savings_text": " ", "percent_savings": 0, "option_text": "Keep Them Sleeping - $4.99", "option_description": "", "can_get_free_license": "0", "is_free_license": false, "price_in_cents_with_discount": 499}]}], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 22, "description": "Steam Achievements"}, {"id": 15, "description": "Stats"}, {"id": 25, "description": "Steam Leaderboards"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "4", "description": "Casual"}, {"id": "28", "description": "Simulation"}], "screenshots": [