src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3504020/extras/2c9d0b8d55f1e03ea113434dd889a27a.webm?t=1786237389\" type=\"video/webm; codecs=vp9\"></video></span></h2><p class=\"bb_paragraph\" style=\"text-align: center\">Find over 20 unique weapons over 50 unique modifiers with stat changing and gameplay changing effects throughout your journey!</p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3504020/extras/3a741136c5f5ae81c1bfdec923d3f477.poster.avif?t=1786237389\" width=780 height=600 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3504020/extras/3a741136c5f5ae81c1bfdec923d3f477.webm?t=1786237389\" type=\"video/webm; codecs=vp9\"></video></span></h2><p class=\"bb_paragraph\" style=\"text-align: center\">In between runs you will spend your time in Shroomstead, a small clearing in the Shroomwood forest where you and your fellow species of sentient mushrooms live. Meet NPCs, upgrade your weapons, discover magical obelisks, and much more! You can also find a shop in every run to cash in your Shroomstone, recover health, meeting interesting NPCs, and, of course, buy new stuff.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "short_description": "Shroomwood is a top-down 2D action roguelike where you play as a little mushroom exploring ever-changing forests, battling infested forest creatures, dual wielding weapons with awesome power, and collecting enchanted items.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3504020/header.jpg?t=1786237389", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3504020/c573b249a542e82115b1e19015e32196df086df7/capsule_231