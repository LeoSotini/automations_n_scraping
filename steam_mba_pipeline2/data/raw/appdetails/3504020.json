c/ss_8d34c859177aaf6dd835072c5e9ec0aa4194a03c.600x338.jpg?t=1786237389", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3504020/8d34c859177aaf6dd835072c5e9ec0aa4194a03c/ss_8d34c859177aaf6dd835072c5e9ec0aa4194a03c.1920x1080.jpg?t=1786237389"}], "movies": [{"id": 257125655, "name": "Shroomwood Gameplay Trailer", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257125655/4cfa1b71bf6ce2a7d115344b37b7eedbc1a51527/movie_600x337.jpg?t=1744584455", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/3504020/869480/93a08a4d10c4f829ee85fd7bf406b00c0b4150c0/1750856498/dash_av1.mpd?t=1744584455", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/3504020/869480/93a08a4d10c4f829ee85fd7bf406b00c0b4150c0/1750856498/dash_h264.mpd?t=1744584455", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/3504020/869480/93a08a4d10c4f829ee85fd7bf406b00c0b4150c0/1750856498/hls_264_master.m3u8?t=1744584455", "highlight": true}, {"id": 257095984, "name": "Shroomwood Reveal Trailer", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257095984/595e559743dd2648d65b2bffd4405af4bd3f41fe/movie_600x337.jpg?t=1740785094", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/3504020/825291/f3fdcee5423e25f41f89f8fec4f15ca7463a5789/1750856497/dash_av1.mpd?t=1740785094", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/3504020/825291/f3fdcee5423e25f41f89f8fec4f15ca7463a5789/1750856497/dash_h264.mpd?t=1740785094", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/3504020/825291/f3fdcee5423e25f41f89f8fec4f15ca7463a5789/1750856497/hls_264_master.m3u8?t=1740785094", "highlight": true}], "release_date": {"coming_soon": true, "date": "2026"}, "support_info": {"url": "https://sporelitegames.com", "email": "sporelitegames@gmail.com"}, "background": "https://store.akamai.steamstatic.com/images/storepagebackground/app/3504020?t=1786237389