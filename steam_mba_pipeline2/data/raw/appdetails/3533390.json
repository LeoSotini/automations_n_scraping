ine poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533390/extras/d4736347520eebbf425519a6c76f5389.poster.avif?t=1784700641\" width=780 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533390/extras/d4736347520eebbf425519a6c76f5389.webm?t=1784700641\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533390/extras/d4736347520eebbf425519a6c76f5389.mp4?t=1784700641\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >FEATURES</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Singleplayer and  cross-platform co-op multiplayer </p></li><li><p class=\"bb_paragraph\" >Over 30 different mission locations in a North American setting </p></li><li><p class=\"bb_paragraph\" >Dynamic missions with random elements: number &amp; location of victims, number &amp; location of fires, blocked or open escape routes </p></li><li><p class=\"bb_paragraph\" >Realistic fire simulation: water, smoke, heat, backdrafts, grease fires, and more </p></li><li><p class=\"bb_paragraph\" >Authentic fire trucks</p></li><li><p class=\"bb_paragraph\" >Authentic equipment and realistic tools</p></li></ul>", "short_description": "When fear takes over, your mission begins: in Firefighters Code Red you battle flames, smoke, and the clock - alone or in cross-platform multiplayer with your squad.", "supported_languages": "English<strong>*</strong>, French, Italian, German, Spanish - Spain, Portuguese - Brazil, Traditional Chinese, Simplified Chinese, Japanese, Korean, Polish, Russian, Spanish - Latin America, Turkish<br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533390/021e94ba443a09d5bba3fde720b685d832956656/header.jpg?t=1784700641", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3533390/cd56a689c2a54581adfa436a69f68f6a16b31fd