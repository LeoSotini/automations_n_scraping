apps/3679880/extras/7b132940ea98039d057402b0761bc74d.webm?t=1770846166\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3679880/extras/7b132940ea98039d057402b0761bc74d.mp4?t=1770846166\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><i>The Core</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Once the Core is disconnected, the clock starts ticking. Mark your escape route, keep your head cool, and make it out before the hull becomes your tomb.</p><h2 class=\"bb_tag\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3679880/extras/5cb8671a19960a435081279be681e7c2.poster.avif?t=1770846166\" width=506 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3679880/extras/5cb8671a19960a435081279be681e7c2.webm?t=1770846166\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3679880/extras/5cb8671a19960a435081279be681e7c2.mp4?t=1770846166\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3679880/extras/840de9f6f322989f5a2449827598db55.poster.avif?t=1770846166\" width=506 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3679880/extras/840de9f6f322989f5a2449827598db55.webm?t=1770846166\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3679880/extras/840de9f6f322989f5a2449827598db55.mp4?t=1770846166\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>SCAVENGER'S TOOLKIT</strong></h2><p cla