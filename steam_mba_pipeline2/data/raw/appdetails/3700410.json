tatic.com/store_item_assets/steam/apps/3700410/81d1ed25f0370adc37c08e1f1046bd5a03377ee4/ss_81d1ed25f0370adc37c08e1f1046bd5a03377ee4.1920x1080.jpg?t=1784862694"}, {"id": 7, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700410/b5cb033c3fac15de6cb44072033b055f9275b495/ss_b5cb033c3fac15de6cb44072033b055f9275b495.600x338.jpg?t=1784862694", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700410/b5cb033c3fac15de6cb44072033b055f9275b495/ss_b5cb033c3fac15de6cb44072033b055f9275b495.1920x1080.jpg?t=1784862694"}, {"id": 8, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700410/db1e6c61d2800bf5f030fbcdf7f230c69e4f84f8/ss_db1e6c61d2800bf5f030fbcdf7f230c69e4f84f8.600x338.jpg?t=1784862694", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700410/db1e6c61d2800bf5f030fbcdf7f230c69e4f84f8/ss_db1e6c61d2800bf5f030fbcdf7f230c69e4f84f8.1920x1080.jpg?t=1784862694"}, {"id": 9, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700410/53b208dc3b81223cc4d76d2d205bf50d118fd328/ss_53b208dc3b81223cc4d76d2d205bf50d118fd328.600x338.jpg?t=1784862694", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700410/53b208dc3b81223cc4d76d2d205bf50d118fd328/ss_53b208dc3b81223cc4d76d2d205bf50d118fd328.1920x1080.jpg?t=1784862694"}, {"id": 10, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700410/12109fc297ebe69e2bb19f791adc68e4dccc2299/ss_12109fc297ebe69e2bb19f791adc68e4dccc2299.600x338.jpg?t=1784862694", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3700410/12109fc297ebe69e2bb19f791adc68e4dccc2299/ss_12109fc297ebe69e2bb19f791adc68e4dccc2299.1920x1080.jpg?t=1784862694"}], "movies": [{"id": 257264522, "name": "Scope Battle Royale - Season 3 Launch Trailer", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/