=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709990/extras/cce84b6a32278abf2dd1e622121a2291.poster.avif?t=1787452219\" width=800 height=800 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709990/extras/cce84b6a32278abf2dd1e622121a2291.webm?t=1787452219\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709990/extras/cce84b6a32278abf2dd1e622121a2291.mp4?t=1787452219\" type=\"video/mp4\"></video></span></p>", "short_description": "Enter the world of Bullet Knight, a fast and brutal boomer shooter that combines roguelite randomness with hand-crafted levels. Each run offers unique challenges filled with relentless action. This game is a tale of love and hate, of nature and humanity.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709990/8cd0a0aa7618a59f33ae01548e044a6f189e5bfd/header.jpg?t=1787452219", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709990/2bf150f25cdd326c74acff4ba41b748af69cc53a/capsule_231x87.jpg?t=1787452219", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3709990/2bf150f25cdd326c74acff4ba41b748af69cc53a/capsule_184x69.jpg?t=1787452219", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5-9400F CPU @ 2.90GHz<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 1050 with 4GB GDDR5<br></li><li><strong>Storage:</strong> 200 MB available space<br></li><li><strong>Sound Card:</strong> Realtek High Definition Audio<br></li><li><strong>VR Support:</strong> No, not yet.</li></ul>", 