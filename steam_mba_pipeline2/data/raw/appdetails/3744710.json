{"3744710": {"success": true, "data": {"type": "game", "name": "Press A: Extremely Realistic Life Simulator", "steam_appid": 3744710, "required_age": 0, "is_free": true, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" ><strong>Press A</strong>, is, much like the protagonist’s vocalization, an artistic expression of the state not only of the game industry, but of most aspects of life in the 2020s.</p><p class=\"bb_paragraph\" ><strong>Press A</strong>, is an experimental project riding on the back of meme culture, that brings an obscure, yet very relevant nowadays, meme to life in an unprecedented manner.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features</strong>:</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Revolutionary approach to game input - you can press [A] to Aaaaaaaaaaaaaa.</p></li><li><p class=\"bb_paragraph\" >Robust statistics system accumulating info on how long you Aaaaaaaaa or how many times you Aaaaaaaaaaa.</p></li><li><p class=\"bb_paragraph\" >Function to even pause and quit the game.</p></li><li><p class=\"bb_paragraph\" >Hand drawn graphics (i'm really proud of this one).</p></li><li><p class=\"bb_paragraph\" >More planned if the demand arises...</p></li></ul><p class=\"bb_paragraph\" ></p>", "about_the_game": "<p class=\"bb_paragraph\" ><strong>Press A</strong>, is, much like the protagonist’s vocalization, an artistic expression of the state not only of the game industry, but of most aspects of life in the 2020s.</p><p class=\"bb_paragraph\" ><strong>Press A</strong>, is an experimental project riding on the back of meme culture, that brings an obscure, yet very relevant nowadays, meme to life in an unprecedented manner.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features</strong>:</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Revolutionary approach to game input - you can press [A] to Aaaaaaaaaaaaaa.</p></li><li><p class=\"bb_paragraph\" >Robust statistics system accumulating info on how long you Aaaaaaaaa or how many times you Aaaaaaaaaaa.</p></li><li><p class=\"bb_paragraph\" >Function to even pause and quit the game.</p></li><li><p class=\"bb_paragraph\" >Hand drawn graphics (i'm really proud of this one).</p></li><li><p class=\"bb_paragraph\" >More planned if the demand arises...</p></li></ul><p class=\"bb_paragraph\" ></p>", "short_description": "Extremely realistic simulator with unprecedented features that let you finally vent all the anxiety modern world induces in you.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3744710/437c8d52d8d31f1f7383c1e7cf27b4051b9bee51/header.jpg?t=1770219500", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3744710/fe0cc130ace68bb0197cb67f7c69438f2706c0b9/capsule_231x87.jpg?t=1770219500", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3744710/fe0cc130ace68bb0197cb67f7c69438f2706c0b9/capsule_184x69.jpg?t=1770219500", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Yes<br></li><li><strong>Memory:</strong> 4000 MB RAM<br></li><li><strong>Graphics:</strong> Present<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 300 MB available space<br></li><li><strong>Sound Card:</strong> Would be nice</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"}, "mac_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"}, "linux_requirements": {"minimum"