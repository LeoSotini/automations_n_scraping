vif?t=1782145459\" width=780 height=182 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795760/extras/5a762a1c6f6697ab8ce9e9b53ceee969.webm?t=1782145459\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795760/extras/5a762a1c6f6697ab8ce9e9b53ceee969.mp4?t=1782145459\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795760/extras/35b812455253b0f3b77db56097cabc95.poster.avif?t=1782145459\" width=780 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795760/extras/35b812455253b0f3b77db56097cabc95.webm?t=1782145459\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795760/extras/35b812455253b0f3b77db56097cabc95.mp4?t=1782145459\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Work together with up to 8 players in online co-op. Coordination is everything - assign roles, juggle tasks, and keep the restaurant from falling apart. Communicate with proximity voice chat to ensure best odds for survival!</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795760/extras/9ebcd64415e6b11ea8285779794c2441.poster.avif?t=1782145459\" width=780 height=182 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795760/extras/9ebcd64415e6b11ea8285779794c2441.webm?t=1782145459\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3795760/extras/9ebcd64415e6b11ea8285779794c2441.mp4?t=1782145459\" type=\"video/mp4\"></video></span></h2><p class=