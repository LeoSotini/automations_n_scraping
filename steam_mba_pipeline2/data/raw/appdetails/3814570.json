取到。</p></li></ul><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >🏯宗门</p><p class=\"bb_paragraph\" >一个强大的宗门，将会成为玩家修仙过程中的重要靠山。加入宗门后只要做出相应的贡献，就可享受宗门带来的大量福利。</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >在这个修真的世界里，资质能让你快人一步，法宝神器能让你比同阶人更强大，但唯有靠超出凡人非同寻常的意志力、敏锐的观察力和一颗不被俗世干扰坚毅的心才能最终蜕凡成仙，成为至高无上的仙尊，这就是凡人修仙的传奇历程!</p>", "short_description": "⚔️以修仙为主题，挂机打BOSS的Idle RPG游戏，玩家将扮演一位普通的少年，在机缘巧合下获得神器昊天镜，从而踏入修行之路，凭借神器的强大与过人的毅力和谨慎的智慧，最终逆天改命、修炼成仙！", "supported_languages": "Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/f5ff2f6c87604ac6d0d5092444a9c1da29c5711c/header.jpg?t=1769743571", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/7babf13f77b7686c8107f78fbff82eae3fb9398f/capsule_231x87.jpg?t=1769743571", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/7babf13f77b7686c8107f78fbff82eae3fb9398f/capsule_184x69.jpg?t=1769743571", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 &amp; Windows 11<br></li><li><strong>Processor:</strong> Intel Core I5<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Storage:</strong> 12 GB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["凡人修仙"], "publishers": ["凡人修仙"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 1, "description": "Multi-player"}, {"id": 20, "description": "MMO"}, {"id": 35, "description": "In-App Purchases"}, {"id": 68, "description": "Custom Volume Controls"}, {"id": 69, "description": "Stereo Sound"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "1", "description": "Action"}, {"id": "25", "description": "Adventure"}, {"id": "4", "description": "Casual"}, {"id": "23", "description": "Indie"}, {"id": "29", "description": "Massively Multiplayer"}, {"id": "3", "description": "RPG"}, {"id": "37", "description": "Free To Play"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/86fc865823bf291e9b5df77900c03cf59d39d048/ss_86fc865823bf291e9b5df77900c03cf59d39d048.600x338.jpg?t=1769743571", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/86fc865823bf291e9b5df77900c03cf59d39d048/ss_86fc865823bf291e9b5df77900c03cf59d39d048.1920x1080.jpg?t=1769743571"}, {"id": 1, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/2a34a1818a3a68cb0005b550496dfd42a67132d4/ss_2a34a1818a3a68cb0005b550496dfd42a67132d4.600x338.jpg?t=1769743571", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/2a34a1818a3a68cb0005b550496dfd42a67132d4/ss_2a34a1818a3a68cb0005b550496dfd42a67132d4.1920x1080.jpg?t=1769743571"}, {"id": 2, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/9fee1d46f872f3bdea3acc7dc73fe1d9484ff032/ss_9fee1d46f872f3bdea3acc7dc73fe1d9484ff032.600x338.jpg?t=1769743571", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/9fee1d46f872f3bdea3acc7dc73fe1d9484ff032/ss_9fee1d46f872f3bdea3acc7dc73fe1d9484ff032.1920x1080.jpg?t=1769743571"}, {"id": 3, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/e2a54636bd8e8d2d6bccb10fa8c25cf03d927f62/ss_e2a54636bd8e8d2d6bccb10fa8c25cf03d927f62.600x338.jpg?t=1769743571", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/e2a54636bd8e8d2d6bccb10fa8c25cf03d927f62/ss_e2a54636bd8e8d2d6bccb10fa8c25cf03d927f62.1920x1080.jpg?t=1769743571"}, {"id": 4, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/f22fbaa8fbce9669a32b674f4c33fc04ad54daad/ss_f22fbaa8fbce9669a32b674f4c33fc04ad54daad.600x338.jpg?t=1769743571", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/f22fbaa8fbce9669a32b674f4c33fc04ad54daad/ss_f22fbaa8fbce9669a32b674f4c33fc04ad54daad.1920x1080.jpg?t=1769743571"}, {"id": 5, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/09988ca4e93d3670b55b4ce6c4c56f6a7492e1dd/ss_09988ca4e93d3670b55b4ce6c4c56f6a7492e1dd.600x338.jpg?t=1769743571", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/09988ca4e93d3670b55b4ce6c4c56f6a7492e1dd/ss_09988ca4e93d3670b55b4ce6c4c56f6a7492e1dd.1920x1080.jpg?t=1769743571"}, {"id": 6, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/3eb1e49d414fd8536bffa3b69001e498cc70f80a/ss_3eb1e49d414fd8536bffa3b69001e498cc70f80a.600x338.jpg?t=1769743571", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3814570/3eb1e49d414fd8536bffa3b69001e498cc70f80a/ss_3eb1e49d414fd8536bffa3b69001e498cc70f80a.1920x1080.jpg?t=1769743571"}], "movies": [{"id": 257185272, "name": "zhandouzhong", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257185272/4a2f38c50ee26d3a2ba68ceb4c6c9c3fe4b88fb9/movie_600x337.jpg?t=1758266555", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/3814570/206920647/78bb6cf62f60cfa8e92c85a081fa6119226bbed3/1755586592/dash_av1.mpd?t=1758266555", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/3814570/206920647/78bb6cf62f60cfa8e92c85a081fa6119226bbed3/1755586592/dash_h264.mpd?t=1758266555", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/3814570/206920647/78bb6cf62f60cfa8e92c85a081fa6119226bbed3/1755586592/hls_264_master.m3u8?t=1758266555", "highlight": true}], "release_date": {"coming_soon": false, "date": "Jan 29, 2026"}, "suppo