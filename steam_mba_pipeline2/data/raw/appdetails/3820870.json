ce src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/extras/cc33ab663c62ff26b8f93b3b0ad2a78d.mp4?t=1785199115\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>SPRINT</strong></p><p class=\"bb_paragraph\" style=\"text-align: center\">There is no speed limit.</p><p class=\"bb_paragraph\" style=\"text-align: center\">Accelerate beyond reason, race through handcrafted levels, and compete against players from around the world.</p><p class=\"bb_paragraph\" style=\"text-align: center\">Someone already has the record. Take it from them. (It's probably Geetar, tbh)</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/extras/f37ec9c7b8ebb0c610c5cf9b26be9fbb.poster.avif?t=1785199115\" width=1170 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/extras/f37ec9c7b8ebb0c610c5cf9b26be9fbb.webm?t=1785199115\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/extras/f37ec9c7b8ebb0c610c5cf9b26be9fbb.mp4?t=1785199115\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>SCULPT</strong></p><p class=\"bb_paragraph\" style=\"text-align: center\">Build the Geometer you wish you were.</p><p class=\"bb_paragraph\" style=\"text-align: center\">Mix hardware and software upgrades across every limb, discover powerful combinations, and create a play-style that is entirely your own.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/extras/b997a055dfcc4c0d23b9ba329067b272.poster.avif?t=1785199115\" width=1170 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/extras/b997a055dfcc4c0d23b9ba329067b272.webm?t=1785199115\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/extras/b997a055dfcc4c0d23b9ba329067b272.mp4?t=1785199115\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><strong>SOAR</strong></p><p class=\"bb_paragraph\" style=\"text-align: center\">Soar to the top of the global leaderboards.</p><p class=\"bb_paragraph\" style=\"text-align: center\">Compete for world records, climb global rankings, and earn recognition reserved for the fastest players alive.</p><p class=\"bb_paragraph\" style=\"text-align: center\">I send merch to the top players each month. &lt;3</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>KEY FEATURES</strong></p><p class=\"bb_paragraph\" >✔ Precision-Driven Gunplay</p><p class=\"bb_paragraph\" >✔ Momentum-Based Movement</p><p class=\"bb_paragraph\" >✔ Airborne Combat System</p><p class=\"bb_paragraph\" >✔ Devastating Ground Slams</p><p class=\"bb_paragraph\" >✔ Projectile Blocking &amp; Deflection</p><p class=\"bb_paragraph\" >✔ Skill-Based Melee Combat</p><p class=\"bb_paragraph\" >✔ Sprinting, Sliding &amp; Bunny Hopping</p><p class=\"bb_paragraph\" >✔ Global Leaderboards</p><p class=\"bb_paragraph\" >✔ Community Challenges</p><p class=\"bb_paragraph\" >✔ Deep Upgrade Customization</p><p class=\"bb_paragraph\" >✔ Hardware &amp; Software Augments</p><p class=\"bb_paragraph\" >✔ Multiple Playstyle Builds</p><p class=\"bb_paragraph\" >✔ Numerous Official Levels</p><p class=\"bb_paragraph\" >✔ Map Editor &amp; Community Maps</p><p class=\"bb_paragraph\" >✔ Speedrun-Oriented Level Design</p><p class=\"bb_paragraph\" >✔ Replayable Mission Structure</p><p class=\"bb_paragraph\" >✔ Abstract Mathematical World</p><p class=\"bb_paragraph\" >✔ Diverse Enemy Roster</p><p class=\"bb_paragraph\" >✔ Real, Tangible Prizes</p><p class=\"bb_paragraph\" >✔ Ongoing Community-Driven Development</p><h2 class=\"bb_tag\" style=\"text-align: center\"></h2>", "short_description": "If you're shooting more than once, you're doing it wrong. At the junction of the physical and informatic realms, Gridpaper is a high-precision FPS headshot speedrunning game where missed shots are punished. Destroy brains, harvest their Informatica for speed, and climb the global leaderboard.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/6bf36bc6a36406b5746c763fe31928d1046373fa/header.jpg?t=1785199115", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/9322c58952036815ef5821fdd3414e1b5485c87d/capsule_231x87.jpg?t=1785199115", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3820870/9322c58952036815ef5821fdd3414e1b5485c87d/capsule_184x69.jpg?t=1785199115", "website": "https://www.gridpaper.gg/", "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3-4130 or AMD FX-6300<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GT 710 / Intel HD Graphics 4000<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> Integrated</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 or 11<br></li><li><strong>Processor:</strong> Intel Core i5-9400F or AMD Ryzen 5 2600<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1050 Ti or AMD Radeon RX 560<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> Integrated, Dedicated</li></ul>"}, "mac_requirements": [], "linux_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 20.04 LTS<br></li><li><strong>Processor:</strong> Intel Core i3-4130 or AMD FX-6300<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 4000 / NVIDIA GT 710<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> Any ALSA-compatible device<br></li><li><strong>Additional Notes:</strong> Tested with Proton and native builds. Vulkan support recommended.</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 22.04 LTS<br></li><li><strong>Processor:</strong> Intel Core i5-9400F or AMD Ryzen 5 2600<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1050 Ti or AMD RX 560 (with Mesa 21.0+)<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> PulseAudio-compatible<br></li><li><strong>Additional Notes:</strong> Tested with Proton and native builds. Vulkan support recommended.</li></ul>"}, "developers": ["fouriersoft"], "publishers": ["fouriersoft"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": true}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 1, "description": "Multi-player"}, {"id": 49, "description": "PvP"}, {"id": 36, "description": "Online PvP"}, {"id": 22, "description": "Steam Achievements"}, {"id": 23, "descri