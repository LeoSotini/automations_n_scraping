l>", "short_description": "Face off against rule-breaking opponents in this Punch-Out!! inspired boss rush! Learn their attack patterns and then dodge with perfect timing. After mastering the basics, take on brutally hard rematch fights. With your coach's help, can you defeat them all?", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3833610/0f823568148997c01f168e7f7731b2587a0c2a03/header.jpg?t=1758916051", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3833610/02258930af9bac231c6c164652d58f75a17cdc7b/capsule_231x87.jpg?t=1758916051", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3833610/02258930af9bac231c6c164652d58f75a17cdc7b/capsule_184x69.jpg?t=1758916051", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i5-7400<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1050 Ti <br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> Any sound card</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["CoDeanGames"], "publishers": ["CoDeanGames"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 22, "description": "Steam Achievements"}, {"id": 28, "description": "Full controller support"}, {"id": 55, "description": "DualShock Controller Support"}, {"id": 57, "description": "DualSense Controller Support"}, {"id": 23, "description": "Steam Cloud"}, {"id": 25, "description": "Steam Leaderboards"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "1