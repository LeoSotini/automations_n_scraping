d.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/69b957d5f9ebe25d3471a79a47a5871637eb3f61/ss_69b957d5f9ebe25d3471a79a47a5871637eb3f61.1920x1080.jpg?t=1780617832"}, {"id": 9, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/4d48745d3342d13e2625679ea709999b8ef51800/ss_4d48745d3342d13e2625679ea709999b8ef51800.600x338.jpg?t=1780617832", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/4d48745d3342d13e2625679ea709999b8ef51800/ss_4d48745d3342d13e2625679ea709999b8ef51800.1920x1080.jpg?t=1780617832"}, {"id": 10, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/497bf41acc41cd69bcaba5496cce477aee084f64/ss_497bf41acc41cd69bcaba5496cce477aee084f64.600x338.jpg?t=1780617832", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/497bf41acc41cd69bcaba5496cce477aee084f64/ss_497bf41acc41cd69bcaba5496cce477aee084f64.1920x1080.jpg?t=1780617832"}, {"id": 11, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/a31b36cd2ba2ac735e126a38996df61bd3a584aa/ss_a31b36cd2ba2ac735e126a38996df61bd3a584aa.600x338.jpg?t=1780617832", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/a31b36cd2ba2ac735e126a38996df61bd3a584aa/ss_a31b36cd2ba2ac735e126a38996df61bd3a584aa.1920x1080.jpg?t=1780617832"}, {"id": 12, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/d059ded7906b373e3d9baf9e05d08e885425e07e/ss_d059ded7906b373e3d9baf9e05d08e885425e07e.600x338.jpg?t=1780617832", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/d059ded7906b373e3d9baf9e05d08e885425e07e/ss_d059ded7906b373e3d9baf9e05d08e885425e07e.1920x1080.jpg?t=1780617832"}, {"id": 13, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885030/f6ee23026d0e12f44ee1eb674f18f8b99f2