t=1787808346\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3905010/extras/08769ad8a16914cafe354c8d942dde09.mp4?t=1787808346\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Get inspired by characters' ideas, choose your ingredients, and work with Sanji to cook delicious dishes. Arrange them into unique meal sets by adding different flourishes, then adventure to find even more recipes! From iconic series favorites like Water-Water Meat BBQ and Sea King Penne Gorgonzola to special creations that harness the powers of Devil Fruits, a treasure trove of dishes awaits.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3905010/extras/0f313ac22312318c90fa6074d672b933.poster.avif?t=1787808346\" width=780 height=380 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3905010/extras/0f313ac22312318c90fa6074d672b933.webm?t=1787808346\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3905010/extras/0f313ac22312318c90fa6074d672b933.mp4?t=1787808346\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3905010/extras/49628318f0b98f337f211cab02b9a64d.avif?t=1787808346\" width=780 height=70 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3905010/extras/329122c09c781f410ea72152bfe2d7ba.poster.avif?t=1787808346\" width=780 height=130 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3905010/extras/329122c09c781f410ea72152bfe2d7