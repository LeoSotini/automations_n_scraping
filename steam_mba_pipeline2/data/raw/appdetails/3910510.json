/3910510/extras/2f985260e533f2dadc6cae4ac537aef5.webm?t=1764345611\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >                       <span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3910510/extras/50306c6e5571ddb7f2090ded17381e08.avif?t=1764345611\" width=432 height=115 /></span></p><p class=\"bb_paragraph\" >Every slip can send you tumbling down.</p><p class=\"bb_paragraph\" >But falling isn’t failure—it’s part of the journey. Learn, adjust, and climb again.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3910510/extras/7dad5e0f2d730f99110b2d7554e8735f.poster.avif?t=1764345611\" width=620 height=295 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3910510/extras/7dad5e0f2d730f99110b2d7554e8735f.webm?t=1764345611\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "short_description": "A frog climbing game about precision charge jumps, tricky platforms, and the tension of falling and trying again. Climb through whimsical worlds, discover new areas, and master your hop to reach the top.", "supported_languages": "English, French, German, Spanish - Spain, Japanese, Korean, Russian, Persian", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3910510/65417bc7b9d61b760ecb4325fd9d9eb5fda83796/header.jpg?t=1764345611", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3910510/157c9cddc4027b07f86a6dc38b22cf2d138863ac/capsule_231x87.jpg?t=1764345611", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_ite