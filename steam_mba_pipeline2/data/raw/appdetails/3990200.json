{"3990200": {"success": true, "data": {"type": "game", "name": "Crimson Tower", "steam_appid": 3990200, "required_age": 0, "is_free": false, "detailed_description": "<p class=\"bb_paragraph\" >A tragic and romantic dark fantasy puzzle game where shadows eclipse the light and mysteries lie waiting to be illuminated. Solve occult-themed puzzles relying on intuition and exploration. Uncover cryptic clues and deep mysteries.  Set in the Realm of Mirrors within the sprawling continent of Miras - a world of diverse kingdoms and cultures - shards of the once powerful Ruunic Empire, now broken and severed from the Light. <br><br>Journey to Miras and uncover a dark plot weaved from the depths of time immemorial. Aid a mysterious traveler and resolve a cosmic rift between a troubled cast of characters, using your wits to illuminate secrets imbued within the world and narrative itself. Choose wisely and set right the wrongs of the past.</p>", "about_the_game": "<p class=\"bb_paragraph\" >A tragic and romantic dark fantasy puzzle game where shadows eclipse the light and mysteries lie waiting to be illuminated. Solve occult-themed puzzles relying on intuition and exploration. Uncover cryptic clues and deep mysteries.  Set in the Realm of Mirrors within the sprawling continent of Miras - a world of diverse kingdoms and cultures - shards of the once powerful Ruunic Empire, now broken and severed from the Light. <br><br>Journey to Miras and uncover a dark plot weaved from the depths of time immemorial. Aid a mysterious traveler and resolve a cosmic rift between a troubled cast of characters, using your wits to illuminate secrets imbued within the world and narrative itself. Choose wisely and set right the wrongs of the past.</p>", "short_description": "A dark fantasy occult-themed puzzle game set in a rich and expansive universe. Featuring open-world exploration and intuition-based puzzles blended into the narrative and world itself. It is centered around a dark narrative of tragedy, love, and redemption.", "supported_languages": "English<strong>*</strong>, French<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3990200/f65a43625e544b0dec5af89e40c1dc1d5bf6e46a/header.jpg?t=1770048552", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3990200/cdd2a6b64772ca9dd044489c49e60f4cb742dc64/capsule_231x87.jpg?t=1770048552", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3990200/cdd2a6b64772ca9dd044489c49e60f4cb742dc64/capsule_184x69.jpg?t=1770048552", "website": "http://www.mirrorsrealm.com", "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Crimson Lune"], "publishers": ["Crimson Lune"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 13, "description": "Captions available"}, {"id": 64, "description": "Adjustable Text Size"}, {"id": 67, "description": "Camera Comfort"}, {"id": 66, "description": "Color Alternatives"}, {"id": 68, "description": "Custom Volume Controls"}, {"id": 71, "description": "Narrated Game Menus"}, {"id": 74, "description": "Playable without Timed Input"}, {"id": 79, "description": "Save Anytime"}, {"id": 69, "description": "Stereo Sound"}, {"id": 65, "description": "Subtitle Options"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "25", "description": "Adventure"}, {"id": "23", "description": "Indie"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3990200/d1bd5ba24b0ad1233bb39e2f57f667bea5dd545d/ss_d1bd5ba24b0ad1233bb39e2f57f667bea5dd545d.600x338.jpg?t=1770048552", "path_full": "https://shared.akamai.steamstatic.com/stor