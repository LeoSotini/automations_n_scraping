steam/apps/4014460/extras/8e109da50906e7ccb26d2b00964dfd72.poster.avif?t=1786120574\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4014460/extras/8e109da50906e7ccb26d2b00964dfd72.webm?t=1786120574\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4014460/extras/8e109da50906e7ccb26d2b00964dfd72.mp4?t=1786120574\" type=\"video/mp4\"></video></span></p></li><li><p class=\"bb_paragraph\" >Explore the manor and its surroundings in search of your missing fellow officers. Uncover the mysterious events that led to the tragic fate of the residents and staff of the Redwood Estate in this atmospheric survival horror experience.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4014460/extras/b9a0ebafaf4a1c658a1da971e61bc8c1.poster.avif?t=1786120574\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4014460/extras/b9a0ebafaf4a1c658a1da971e61bc8c1.webm?t=1786120574\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4014460/extras/b9a0ebafaf4a1c658a1da971e61bc8c1.mp4?t=1786120574\" type=\"video/mp4\"></video></span></p></li><li><p class=\"bb_paragraph\" >Search every corner for the tools you’ll need to survive against terrifying enemies while carefully managing your limited resources.<span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4014460/extras/7bd09012c9086487b81f0bd72703d942.poster.avif?t=1786120574\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4014460/extras/7bd09012c9086487b81f0bd72703d942.webm?t=1786120574\" type=\"video/webm; codecs=