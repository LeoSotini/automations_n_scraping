.jpg?t=1787092469"}, {"id": 7, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/6dd7d1f502b13ea5b6c234a66a2156352f05dc03/ss_6dd7d1f502b13ea5b6c234a66a2156352f05dc03.600x338.jpg?t=1787092469", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/6dd7d1f502b13ea5b6c234a66a2156352f05dc03/ss_6dd7d1f502b13ea5b6c234a66a2156352f05dc03.1920x1080.jpg?t=1787092469"}, {"id": 8, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/4bbae4c3565eea0ea7726ed63e4593c5a36e657f/ss_4bbae4c3565eea0ea7726ed63e4593c5a36e657f.600x338.jpg?t=1787092469", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/4bbae4c3565eea0ea7726ed63e4593c5a36e657f/ss_4bbae4c3565eea0ea7726ed63e4593c5a36e657f.1920x1080.jpg?t=1787092469"}], "movies": [{"id": 257227388, "name": "Heart Drive - Teaser", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257227388/377d09d2aae492034c2a8a808d6d46d36db85868/movie_600x337.jpg?t=1763678621", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/4026760/1050181411/247a2e86384faa7aa34b59844afda63fbfc093ed/1763677093/dash_av1.mpd?t=1763678621", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/4026760/1050181411/247a2e86384faa7aa34b59844afda63fbfc093ed/1763677093/dash_h264.mpd?t=1763678621", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/4026760/1050181411/247a2e86384faa7aa34b59844afda63fbfc093ed/1763677093/hls_264_master.m3u8?t=1763678621", "highlight": true}], "release_date": {"coming_soon": true, "date": "To be announced"}, "support_info": {"url": "", "email": "polygonasgames@gmail.com"}, "background": "https://store.akamai.steamstatic.com/images/storepagebackground/app/4026760?t=1787092469", "background_raw": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4026760/2bba079339b6fed53263ac77b69cacf9fd35375b/page_bg_raw.jpg?t