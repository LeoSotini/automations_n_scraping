{"4036460": {"success": true, "data": {"type": "game", "name": "Midnight Gambit", "steam_appid": 4036460, "required_age": 0, "is_free": false, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" ><strong>Midnight Gambit</strong> is a single-player roguelite game, that combines stealth and gambling mechanics with the fast-paced gameplay and build-focused crafting of survivor-like games. Players must hide in plain-sight, biting guests in the shadows to stay alive without raising the alarm. Meanwhile, raking in chips from the casino by gambling and killing. Collecting chips is the main objective, but chips can also be used to upgrade abilities in the casino, or be turned into cash to buy new abilities to bring into the casino next time.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Collect abilities</strong> and create <strong>unique builds</strong>. Conquer all the <strong>difficulty modes</strong> and <strong>discover new enemies</strong>. <strong>Use blessings and curses</strong> to add flair to your game. Become the luckiest vampire to ever walk into Las Vegas.</p>", "about_the_game": "<p class=\"bb_paragraph\" ><strong>Midnight Gambit</strong> is a single-player roguelite game, that combines stealth and gambling mechanics with the fast-paced gameplay and build-focused crafting of survivor-like games. Players must hide in plain-sight, biting guests in the shadows to stay alive without raising the alarm. Meanwhile, raking in chips from the casino by gambling and killing. Collecting chips is the main objective, but chips can also be used to upgrade abilities in the casino, or be turned into cash to buy new abilities to bring into the casino next time.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Collect abilities</strong> and create <strong>unique builds</strong>. Conquer all the <strong>difficulty modes</strong> and <strong>discover new enemies</strong>. <strong>Use blessings and curses</strong> to add flair to your game. Become the luckiest vampire to ever walk into Las Vegas.</p>", "short_description": "So you're a vampire, and your new boss has a cape and a spreadsheet. Dracula wants his cut, and he wants it monthly. You control Sonny, a gambling addicted vampire with a coat-full of luck. Drink blood, gamble and create unique-builds to survive this wave based stealth-action roguelite in Sin City.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4036460/4875e7fd6bcc24484f3b4aae79968ccc77f19c0d/header.jpg?t=1785182318", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4036460/2b0de929ca86dffab860e3f82a8ecaf939fdea83/capsule_231x87.jpg?t=1785182318", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4036460/2b0de929ca86dffab860e3f82a8ecaf939fdea83/capsule_184x69.jpg?t=1785182318", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 11 64 bit<br></li><li><strong>Processor:</strong> 16GB<br></li><li><strong>Graphics:</strong> GTX 960<br></li><li><strong>Storage:</strong> 12 GB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Solstice Games"], "publishers": ["National Film & Televsion School"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 28, "description": "Full controller support"}, {"id": 68, "description": "Custom Volume Controls"}, {"id": 78, "description": "Adjustable Difficulty"}, {"id": 74, "description": "Playable without Timed Input"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "1", "description": "Action"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.