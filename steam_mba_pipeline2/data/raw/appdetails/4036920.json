{"4036920": {"success": true, "data": {"type": "game", "name": "Everbrew", "steam_appid": 4036920, "required_age": 0, "is_free": false, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" >Everbrew is a cozy pixel-art management game where you'll farm, cook, and design your very own woodland café. Harvest ingredients, craft delicious meals, and welcome woodland creatures as they gather to relax, eat, and feel at home.<br><br> Features</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Run Your Business</strong> – Take orders, cook recipes, and serve charming woodland guests while keeping them happy and fed. </p></li><li><p class=\"bb_paragraph\" ><strong>Cook With Care</strong> – Create unique recipes using fresh forest ingredients. From acorn stews to dandelion brews, every dish is handcrafted with hundreds of recipes to unlock.</p></li><li><p class=\"bb_paragraph\" ><strong>Design your Cafe </strong>– Arrange your café how you want. Unlock new furniture and decorations to create a cozy space that’s truly your own.</p></li><li><p class=\"bb_paragraph\" ><strong>Harvest the Wilds</strong> – Tend to your farm while foraging for berries, herbs, and other ingredients from the surrounding forest to keep your pantry stocked. Explore new areas to discover more ingredients to add to your recipes.</p></li><li><p class=\"bb_paragraph\" ><strong>Play Your Way</strong> – Each day is yours to shape. Open the café, work on the farm, explore the wilderness, or simply relax by the fire.</p></li></ul>", "about_the_game": "<p class=\"bb_paragraph\" >Everbrew is a cozy pixel-art management game where you'll farm, cook, and design your very own woodland café. Harvest ingredients, craft delicious meals, and welcome woodland creatures as they gather to relax, eat, and feel at home.<br><br> Features</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Run Your Business</strong> – Take orders, cook recipes, and serve charming woodland guests while keeping them happy and fed. </p></li><li><p class=\"bb_paragraph\" ><strong>Cook With Care</strong> – Create unique recipes using fresh forest ingredients. From acorn stews to dandelion brews, every dish is handcrafted with hundreds of recipes to unlock.</p></li><li><p class=\"bb_paragraph\" ><strong>Design your Cafe </strong>– Arrange your café how you want. Unlock new furniture and decorations to create a cozy space that’s truly your own.</p></li><li><p class=\"bb_paragraph\" ><strong>Harvest the Wilds</strong> – Tend to your farm while foraging for berries, herbs, and other ingredients from the surrounding forest to keep your pantry stocked. Explore new areas to discover more ingredients to add to your recipes.</p></li><li><p class=\"bb_paragraph\" ><strong>Play Your Way</strong> – Each day is yours to shape. Open the café, work on the farm, explore the wilderness, or simply relax by the fire.</p></li></ul>", "short_description": "Farm, cook, and design your very own woodland café in Everbrew, a cozy pixel-art management game. Harvest ingredients, craft delicious meals, and welcome woodland creatures as they gather to relax, eat, and feel at home.", "supported_languages": "English, French, German, Spanish - Spain, Japanese, Korean, Portuguese - Brazil, Simplified Chinese, Spanish - Latin America, Thai", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4036920/ccc49872cb16104bbac628a5416b279d33fd02fa/header.jpg?t=1780538281", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4036920/080419a9119eba6cb90809763fc9f4a59dcd2557/capsule_231x87.jpg?t=1780538281", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4036920/080419a9119eba6cb90809763fc9f4a59dcd2557/capsule_184x69.jpg?t=1780538281", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 7/8/10 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3-2100 or AMD FX-6300<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 4000 / NVIDIA GeForce GTX 560 / AMD Radeon HD 7770 (or equivalent with 1 GB VRAM)<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space<br></li><li><strong>Additional Notes:</strong> Runs on low-end laptops and integrated graphics.</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10/11 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i5-6500 or AMD Ryzen 3 1200<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 960 / AMD Radeon R9 280 (or newer, 2 GB VRAM)<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space<br></li><li><strong>Additional Notes:</strong> Recommended for smoother performance and higher resolutions.</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Moonpetal Studio"], "publishers": ["Moonpetal Studio"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 28, "description": "Full controller support"}, {"id": 55, "description": "DualShock Controller Support"}, {"id": 56, "description": "DualShock Controller Support"}, {"id": 57, "description": "DualSense Controller Support"}, {"id": 58, "description": "DualSense Controller Support"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "25", "description": "Adventure"}, {"id": "4", "description": "Casual"}, {"id": "3", "description": "RPG"}, {"id": "28", "description": "Simulation"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4036920/2b12f48bc010d9c38869218bbcac20ea21bdb88a/ss_2b12f48bc010d9c38869218bbcac20ea21bdb88a.600x338.jpg