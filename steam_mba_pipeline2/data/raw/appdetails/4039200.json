/steam/apps/4039200/f271a78032ce63586e37ad5b882c346945f96850/ss_f271a78032ce63586e37ad5b882c346945f96850.1920x1080.jpg?t=1787824372"}], "movies": [{"id": 257409193, "name": "Exterminauts - Gameplay Trailer", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257409193/1e0cfbf4334749bea2caeaedb690d5a91d2fd093/movie_600x337.jpg?t=1787824371", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/4039200/640905386/a9c4cd47292f88f37a8650464bf57eea6ac3acaa/1787754890/dash_av1.mpd?t=1787824371", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/4039200/640905386/a9c4cd47292f88f37a8650464bf57eea6ac3acaa/1787754890/dash_h264.mpd?t=1787824371", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/4039200/640905386/a9c4cd47292f88f37a8650464bf57eea6ac3acaa/1787754890/hls_264_master.m3u8?t=1787824371", "highlight": true}, {"id": 257401464, "name": "Exterminauts - Announcement Trailer", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257401464/82b47c65e1d22bef3399f210073111087b296189/movie_600x337.jpg?t=1787681349", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/4039200/125260527/e95e66b2265472fd42e29f7401f9bf72e666f036/1786977362/dash_av1.mpd?t=1787681349", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/4039200/125260527/e95e66b2265472fd42e29f7401f9bf72e666f036/1786977362/dash_h264.mpd?t=1787681349", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/4039200/125260527/e95e66b2265472fd42e29f7401f9bf72e666f036/1786977362/hls_264_master.m3u8?t=1787681349", "highlight": true}], "release_date": {"coming_soon": true, "date": "Coming soon"}, "support_info": {"url": "", "email": "support@exterminauts.com"}, "background": "https://store.akamai.steamstatic.com/images/storepagebackground/app/4039200?t=1787824372", "background_raw": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4039200/d2fd30b0b3d7076453ca539d5bd540e76eefd79c/page_bg_raw.jpg?t=1787824372", "content_descriptors": {"ids": [2, 5], "notes": "Exterminauts is a 3rd person crew-based shooter that sees the far future blue collar themed exterminators clearing intergalactic pests for the corporations. \r\n\r\nFrom a 3rd person perspective, players use a variety of weapons (i.e Shotguns, rifles) and power tools (i.e Ice Cannon, Acid foams) to shoot and kill the intergalactic pests. Combat is accompanied by frequent sprays of unrealistic alien blood and gore as players exterminate the alien pests with wide assortment of weapons and tools. \r\n\r\nSome mature language are used to express the blue-collar theme of the game."}, "ratings": {"dejus": {"rating_generated": "1", "rating": "14", "required_age": "14", "banned": "0", "use_age_gate": "0", "descriptors": "Linguagem imprópria\nViolência"}, "steam_germany": {"rating_generated": "1", "rating": "16", "required_age": "16", "banned": "0", "use_age_gate": "0", "descriptors": "Drastische Gewalt\nDerbe Sprache"}, "igrs": {"rating_generated": "1", "rating": "18", "required_age": "18", "banned": "0", "use_age_gate": "0", "descriptors": "Interaksi Daring\nKekerasan\nPenggunaan bahasa"}}}}}