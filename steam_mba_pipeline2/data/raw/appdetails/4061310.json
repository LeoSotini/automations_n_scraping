uted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4061310/extras/e2d05dcee4598a9059711ca1b180a4c7.poster.avif?t=1785292625\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4061310/extras/e2d05dcee4598a9059711ca1b180a4c7.webm?t=1785292625\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4061310/extras/e2d05dcee4598a9059711ca1b180a4c7.mp4?t=1785292625\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "short_description": "Experience a survival-horror nightmare like no other. In The Deafening, your survival depends on quick thinking, sharp wits, and careful planning. Explore, improvise, and outsmart the horrors around every corner—all decisions matter!", "supported_languages": "English<strong>*</strong>, Spanish - Spain, Arabic, Spanish - Latin America<br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4061310/a8e2e792081a4c2215ecd6f9e4a994b9568fa7d1/header.jpg?t=1785292625", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4061310/b4908b24923e4ec22fad1c9be5d40d0a5660ffc4/capsule_231x87.jpg?t=1785292625", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4061310/b4908b24923e4ec22fad1c9be5d40d0a5660ffc4/capsule_184x69.jpg?t=1785292625", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 64-bit<br></li><li><strong>Processor:</strong> Intel Core i5-8400 or AMD Ryzen 3 3100<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 1060 (6 GB) / AMD Radeon RX 580 (8 GB)<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 20 GB avail