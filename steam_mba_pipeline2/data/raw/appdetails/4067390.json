{"4067390": {"success": true, "data": {"type": "game", "name": "LuminousStoria", "steam_appid": 4067390, "required_age": 0, "is_free": false, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" >&quot;Do you know the story of Luminous?&quot;</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Uplifting music and</p><p class=\"bb_paragraph\" >An exciting work in which you defeat more and more monsters in the world of swords.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >&quot;Luminous Storia&quot;</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >An impressive character advances through the ruins with the village's treasured sword</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >□STORY</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The boy's name is Luck.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >A villager living in a remote village.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >He wants to be a hero.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >It is said that anyone who sees Luminous will be praised by everyone.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Luck took out the village sword to be praised by everyone.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >&quot;I want to be like a hero.&quot;</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Luck is determined in his heart,</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >He headed to the ruins where monsters were wandering.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The ruins of a monster that villagers do not approach.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Will Luck be able to see the Luminous?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >□GAME</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Easy operation with gamepad, simple sword attack and jump</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Swing the sword down at the monster, cut vertically</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Swing the sword from the side, cross</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Attack quickly, thrust</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Use three different attacks to defeat monsters</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Explore by pressing a switch to open a closed door</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Let's go see Luminous with Luck</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >□SOUND</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Rhythmic high-quality background music that beats the world of swords</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >□SYSTEM</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Every time you attack a monster, you get experience points.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Raise your level and defeat powerful enemies.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "about_the_game": "<p class=\"bb_paragraph\" >&quot;Do you know the story of Luminous?&quot;</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Uplifting music and</p><p class=\"bb_paragraph\" >An exciting work in which you defeat more and more monsters in the world of swords.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >&quot;Luminous Storia&quot;</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >An impressive character advances through the ruins with the village's treasured sword</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >□STORY</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The boy's name is Luck.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >A villager living in a remote village.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >He wants to be a hero.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >It is said that anyone who sees Luminous will be praised by everyone.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Luck took out the village sword to be praised by everyone.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >&quot;I want to be like a hero.&quot;</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Luck is determined in his heart,</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >He headed to the ruins where monsters were wandering.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The ruins of a monster that villagers do not approach.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Will Luck be able to see the Luminous?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >□GAME</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Easy operation with gamepad, simple sword attack and jump</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Swing the sword down at the monster, cut vertically</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Swing the sword from the side, cross</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Attack quickly, thrust</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Use three different attacks to defeat monsters</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Explore by pressing a switch to open a closed door</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >・Let's go see Luminous with Luck</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >□SOUND</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Rhythmic high-quality background music that beats the world of swords</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >□SYSTEM</p><p class=\"bb_paragraph\" ></p><p class=\"bb_para