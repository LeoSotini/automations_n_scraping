0cd2817.poster.avif?t=1775566745\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/f99262d019e85a221838148280cd2817.webm?t=1775566745\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/f99262d019e85a221838148280cd2817.mp4?t=1775566745\" type=\"video/mp4\"></video></span> </p><p class=\"bb_paragraph\" style=\"text-align: center\">Use tools on dynamic surfaces to ignite fires, shock enemies, and more:</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/3f84591d222741a1ff92a8edd5b8882f.poster.avif?t=1775566745\" width=850 height=434 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/3f84591d222741a1ff92a8edd5b8882f.webm?t=1775566745\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/3f84591d222741a1ff92a8edd5b8882f.mp4?t=1775566745\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><strong>ENEMIES</strong></h2><p class=\"bb_paragraph\" style=\"text-align: center\">A wealth of different enemies, all with their own strengths and weaknesses:</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/5fec62418957672cb03d8bb457f1e9b3.avif?t=1775566745\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras_big/5fec62418957672cb03d8bb457f1e9b3.webp?t=1775566745 width=1560 height=719 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/669f2b1052bfc38a8e8051a2a3f310ef.avif?t=1775566745\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras_big/669f2b1052bfc38a8e8051a2a3f310ef.webp?t=1775566745 width=1560 height=719 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/8e3e06a47692257882ea41e1a5671d1c.avif?t=1775566745\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras_big/8e3e06a47692257882ea41e1a5671d1c.webp?t=1775566745 width=1560 height=719 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/337bfe4f36c96d30fa00370174ef1bd0.avif?t=1775566745\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras_big/337bfe4f36c96d30fa00370174ef1bd0.webp?t=1775566745 width=1560 height=719 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><i>(and many more!)</i></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\">TAKE A BREAK</h2><p class=\"bb_paragraph\" style=\"text-align: center\">Brew coffee and microwave food to prepare consumables for your next outing:</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/af8e4632723d617ceecdf78cf131943d.poster.avif?t=1775566745\" width=1056 height=588 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/af8e4632723d617ceecdf78cf131943d.webm?t=1775566745\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/af8e4632723d617ceecdf78cf131943d.mp4?t=1775566745\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/6e183953fde969755e49f46b5c176c09.poster.avif?t=1775566745\" width=750 height=402 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/6e183953fde969755e49f46b5c176c09.webm?t=1775566745\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/extras/6e183953fde969755e49f46b5c176c09.mp4?t=1775566745\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">Explore at your own pace. But be aware that you are not alone, and resources are scarce. There is no in-game map. Just your memory, your notes, and the human instinct to survive.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "short_description": "The Hollow Complex is an action-filled survival thriller inspired by the Backrooms. Dive into a dark and twisted rendition of internet folklore that actually allows you to fight back. Explore, scavenge, complete quests, and find a way out of a seemingly endless labyrinth.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/7cf82b4c05a7a44ada764c46d1098e454a070921/header.jpg?t=1775566745", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/34ffd660460bda360696b6e1df331ebabc7dcb4d/capsule_231x87.jpg?t=1775566745", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4087830/34ffd660460bda360696b6e1df331ebabc7dcb4d/capsule_184x69.jpg?t=1775566745", "website": null, "pc_requirements":