38.jpg?t=1787255534", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/ee4d478ec61a5d38831d0a0b96c9ce9819793e96/ss_ee4d478ec61a5d38831d0a0b96c9ce9819793e96.1920x1080.jpg?t=1787255534"}, {"id": 5, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/6cb5a3c3a76cacfb1a758b41b0d8a8772b91102c/ss_6cb5a3c3a76cacfb1a758b41b0d8a8772b91102c.600x338.jpg?t=1787255534", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/6cb5a3c3a76cacfb1a758b41b0d8a8772b91102c/ss_6cb5a3c3a76cacfb1a758b41b0d8a8772b91102c.1920x1080.jpg?t=1787255534"}, {"id": 6, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/16b973c13473ad621b39d9257e09cce87741b418/ss_16b973c13473ad621b39d9257e09cce87741b418.600x338.jpg?t=1787255534", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/16b973c13473ad621b39d9257e09cce87741b418/ss_16b973c13473ad621b39d9257e09cce87741b418.1920x1080.jpg?t=1787255534"}, {"id": 7, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/cec19b279dd071d75f726f917f8720804b34b376/ss_cec19b279dd071d75f726f917f8720804b34b376.600x338.jpg?t=1787255534", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/cec19b279dd071d75f726f917f8720804b34b376/ss_cec19b279dd071d75f726f917f8720804b34b376.1920x1080.jpg?t=1787255534"}, {"id": 8, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/cb0432e62938b48e270910fb7dc49674f10424fc/ss_cb0432e62938b48e270910fb7dc49674f10424fc.600x338.jpg?t=1787255534", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4117260/cb0432e62938b48e270910fb7dc49674f10424fc/ss_cb0432e62938b48e270910fb7dc49674f10424fc.1920x1080.jpg?t=1787255534"}, {"id": 9, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/app