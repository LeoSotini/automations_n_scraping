{"4177990": {"success": true, "data": {"type": "game", "name": "No Shot", "steam_appid": 4177990, "required_age": 0, "is_free": true, "detailed_description": "<p class=\"bb_paragraph\" >No Shot is an intense zero-gravity team sport only possible in Virtual Reality. Join up with your team, execute precise passing plays, and score points to claim victory.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Team vs Team</h2><p class=\"bb_paragraph\" >Matchmake or party up with your team and work together to score the disc in your enemy's goal. Execute precise passing plays, grab off each-other for speed, and punch out the enemy defense to score the disc in the goal!</p><h2 class=\"bb_tag\" >Built for Virtual Reality</h2><p class=\"bb_paragraph\" >Use hand based locomotion to effortlessly push off any surface in zero-gravity, or use your hand thrusters to redirect your momentum. Grab onto and push yourself off any object, even your teammates!</p><h2 class=\"bb_tag\" >Become a Champion</h2><p class=\"bb_paragraph\" >Climb the ranks and make a name for yourself. Unlock exclusive cosmetics and get your accomplishments displayed in the lobby for all to see.</p><p class=\"bb_paragraph\" ></p>", "about_the_game": "<p class=\"bb_paragraph\" >No Shot is an intense zero-gravity team sport only possible in Virtual Reality. Join up with your team, execute precise passing plays, and score points to claim victory.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Team vs Team</h2><p class=\"bb_paragraph\" >Matchmake or party up with your team and work together to score the disc in your enemy's goal. Execute precise passing plays, grab off each-other for speed, and punch out the enemy defense to score the disc in the goal!</p><h2 class=\"bb_tag\" >Built for Virtual Reality</h2><p class=\"bb_paragraph\" >Use hand based locomotion to effortlessly push off any surface in zero-gravity, or use your hand thrusters to redirect your momentum. Grab onto and push yourself off any object, even your teammates!</p><h2 class=\"bb_tag\" >Become a Champion</h2><p class=\"bb_paragraph\" >Climb the ranks and make a name for yourself. Unlock exclusive cosmetics and get your accomplishments displayed in the lobby for all to see.</p><p class=\"bb_paragraph\" ></p>", "short_description": "Launch into a zero-gravity arena and execute with your team in a fast-paced and intense sport only possible in virtual reality.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4177990/d0700952b0f319f10afa04f649a76e9817cd50ae/header.jpg?t=1770284199", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4177990/ff1f65a00cc1448530be1ee9bd4be4fe9e0f389f/capsule_231x87.jpg?t=1770284199", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4177990/ff1f65a00cc1448530be1ee9bd4be4fe9e0f389f/capsule_184x69.jpg?t=1770284199", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>VR Support:</strong> SteamVR with OpenXR</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>VR Support:</strong> SteamVR with OpenXR</li></ul>"}, "mac_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"}, "linux_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"}, "developers": ["Iteration Three"], "publishers": ["Iteration Three"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 1, "description": "Multi-player"