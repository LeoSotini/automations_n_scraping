path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/6d1f872dd10aeaf8ff8ce07b32c8fe3bfc8c22d7/ss_6d1f872dd10aeaf8ff8ce07b32c8fe3bfc8c22d7.600x338.jpg?t=1788225905", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/6d1f872dd10aeaf8ff8ce07b32c8fe3bfc8c22d7/ss_6d1f872dd10aeaf8ff8ce07b32c8fe3bfc8c22d7.1920x1080.jpg?t=1788225905"}, {"id": 6, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/07ebc9a79ebc0e57a520b47467d1d175e341fb0e/ss_07ebc9a79ebc0e57a520b47467d1d175e341fb0e.600x338.jpg?t=1788225905", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/07ebc9a79ebc0e57a520b47467d1d175e341fb0e/ss_07ebc9a79ebc0e57a520b47467d1d175e341fb0e.1920x1080.jpg?t=1788225905"}, {"id": 7, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/79bf0ab4287cdd5cf28a5992cceeb05fd3e4c5cf/ss_79bf0ab4287cdd5cf28a5992cceeb05fd3e4c5cf.600x338.jpg?t=1788225905", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/79bf0ab4287cdd5cf28a5992cceeb05fd3e4c5cf/ss_79bf0ab4287cdd5cf28a5992cceeb05fd3e4c5cf.1920x1080.jpg?t=1788225905"}, {"id": 8, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/3dcf0971e67cab7b6ecd3456167ab76277ba5aac/ss_3dcf0971e67cab7b6ecd3456167ab76277ba5aac.600x338.jpg?t=1788225905", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/3dcf0971e67cab7b6ecd3456167ab76277ba5aac/ss_3dcf0971e67cab7b6ecd3456167ab76277ba5aac.1920x1080.jpg?t=1788225905"}, {"id": 9, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/f2282badda3946f1fcee1eee0c40856c1ab870eb/ss_f2282badda3946f1fcee1eee0c40856c1ab870eb.600x338.jpg?t=1788225905", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4180840/f2282badda3946f1fcee1eee0c