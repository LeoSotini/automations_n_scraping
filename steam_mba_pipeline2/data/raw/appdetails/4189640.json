ore_item_assets/steam/apps/4189640/extras/7f8a6359df35ac894e3b8528af382b13.mp4?t=1786679673\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\">FEED. THE. MAW</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>You will also be able to</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Unlock cosmetics and change up your appearance</p></li><li><p class=\"bb_paragraph\" >Use tools to fight off island creatures</p></li><li><p class=\"bb_paragraph\" >Collect achievements and add them as your tattoo</p></li><li><p class=\"bb_paragraph\" >Pray to the ancestors to gain special power</p></li><li><p class=\"bb_paragraph\" >Drink island brews to enhance your abilities</p></li><li><p class=\"bb_paragraph\" >Use the catapult <span class=\"bb_strike\">for fun</span> to explore the island</p></li></ul><p class=\"bb_paragraph\" >and many more &quot;islandy&quot; stuff awaits. So get moving and find food before the time runs out!</p><p class=\"bb_paragraph\" ></p>", "short_description": "The Maw is hungry, you and your friends are the island's chosen heroes. Explore the deadly, mysterious island with your fellow islanders and loot for offerings to feed the beast before he gets angry!", "supported_languages": "English, Indonesian, French, Italian, German, Spanish - Spain, Japanese, Korean, Polish, Portuguese - Brazil, Portuguese - Portugal, Russian, Simplified Chinese", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4189640/7f1d811373d6d1c67cdf714344668cb03a49b05b/header.jpg?t=1786679673", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4189640/8dc651ab8e5f4b84b5b1fb8024889e3311970f91/capsule_231x87.jpg?t=1786679673", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4189640/8dc651ab8e5f4b84b5b1fb8024889e3311970f91/capsule_184x69.jpg?t=1786679673", "website": "https://onesunday.studio/", "pc_requiremen