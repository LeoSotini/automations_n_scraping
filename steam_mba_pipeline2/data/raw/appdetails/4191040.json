_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/0e6cb3b4a5fa063f034f16cb7dd3688fe9f7813c/ss_0e6cb3b4a5fa063f034f16cb7dd3688fe9f7813c.600x338.jpg?t=1764844150", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/0e6cb3b4a5fa063f034f16cb7dd3688fe9f7813c/ss_0e6cb3b4a5fa063f034f16cb7dd3688fe9f7813c.1920x1080.jpg?t=1764844150"}, {"id": 5, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/2d250b9f368bc68f926727f73f71b79e56661dd9/ss_2d250b9f368bc68f926727f73f71b79e56661dd9.600x338.jpg?t=1764844150", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/2d250b9f368bc68f926727f73f71b79e56661dd9/ss_2d250b9f368bc68f926727f73f71b79e56661dd9.1920x1080.jpg?t=1764844150"}, {"id": 6, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/4c30fa1600293ee2ec74652bc15ef98f872cf0de/ss_4c30fa1600293ee2ec74652bc15ef98f872cf0de.600x338.jpg?t=1764844150", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/4c30fa1600293ee2ec74652bc15ef98f872cf0de/ss_4c30fa1600293ee2ec74652bc15ef98f872cf0de.1920x1080.jpg?t=1764844150"}, {"id": 7, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/ed9a4ce7a03fdda1bbb8ec30e68f69c697eb79ec/ss_ed9a4ce7a03fdda1bbb8ec30e68f69c697eb79ec.600x338.jpg?t=1764844150", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/ed9a4ce7a03fdda1bbb8ec30e68f69c697eb79ec/ss_ed9a4ce7a03fdda1bbb8ec30e68f69c697eb79ec.1920x1080.jpg?t=1764844150"}, {"id": 8, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/36e10354242fa4f9b7903b9fdbe39e514b36599e/ss_36e10354242fa4f9b7903b9fdbe39e514b36599e.600x338.jpg?t=1764844150", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4191040/36e10354242fa4f9b7903b9fdbe39e