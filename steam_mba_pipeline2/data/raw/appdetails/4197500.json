/mp4\"></video></span></p><h2 class=\"bb_tag\" ></h2><h2 class=\"bb_tag\" >Combine elements:</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4197500/extras/8647d27290e2ea7a76277c4c3b044a5f.poster.avif?t=1788092067\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4197500/extras/8647d27290e2ea7a76277c4c3b044a5f.webm?t=1788092067\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4197500/extras/8647d27290e2ea7a76277c4c3b044a5f.mp4?t=1788092067\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Combine metals and solutions:</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4197500/extras/1147022606e16c5f1847ca2aa6de44be.poster.avif?t=1788092067\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4197500/extras/1147022606e16c5f1847ca2aa6de44be.webm?t=1788092067\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4197500/extras/1147022606e16c5f1847ca2aa6de44be.mp4?t=1788092067\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Use Charged probes in the field:</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4197500/extras/a0a2ea61bb3451d07aa15e7fa37f98eb.poster.avif?t=1788092067\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4197500/extras/a0a2ea61bb3451d07aa15e7fa37f98eb.webm?t=1788