{"4209370": {"success": true, "data": {"type": "game", "name": "Girl Island", "steam_appid": 4209370, "required_age": 0, "is_free": false, "detailed_description": "<h2 class=\"bb_tag\" >About the game:</h2><p class=\"bb_paragraph\" >You will survive on a dreamy tropical island, building a beautiful homeland.</p><h2 class=\"bb_tag\" >Game Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Supports single-player and multiplayer modes, allowing you to create private servers and play with friends.</p></li><li><p class=\"bb_paragraph\" >Pet system: Tame most animals for riding and feeding your pets.</p></li><li><p class=\"bb_paragraph\" >Fishing system: You can fish for various tropical fish in the ocean.</p></li><li><p class=\"bb_paragraph\" >Powerful building system: Create your unique base and buildings.</p></li><li><p class=\"bb_paragraph\" >Craft various weapons and tools.</p></li><li><p class=\"bb_paragraph\" >You can  hunt various dangerous animals.</p></li><li><p class=\"bb_paragraph\" >Dynamic day-night cycle and weather system.</p></li><li><p class=\"bb_paragraph\" >Select different female characters</p></li><li><p class=\"bb_paragraph\" >Supports switching between first-person and third-person perspectives</p><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "about_the_game": "<h2 class=\"bb_tag\" >About the game:</h2><p class=\"bb_paragraph\" >You will survive on a dreamy tropical island, building a beautiful homeland.</p><h2 class=\"bb_tag\" >Game Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Supports single-player and multiplayer modes, allowing you to create private servers and play with friends.</p></li><li><p class=\"bb_paragraph\" >Pet system: Tame most animals for riding and feeding your pets.</p></li><li><p class=\"bb_paragraph\" >Fishing system: You can fish for various tropical fish in the ocean.</p></li><li><p class=\"bb_paragraph\" >Powerful building system: Create your unique base and buildings.</p></li><li><p class=\"bb_paragraph\" >Craft various weapons and tools.</p></li><li><p class=\"bb_paragraph\" >You can  hunt various dangerous animals.</p></li><li><p class=\"bb_paragraph\" >Dynamic day-night cycle and weather system.</p></li><li><p class=\"bb_paragraph\" >Select different female characters</p></li><li><p class=\"bb_paragraph\" >Supports switching between first-person and third-person perspectives</p><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "short_description": "This is a casual island survival game.", "supported_languages": "English, Simplified Chinese, French, Italian, German, Spanish - Spain, Danish, Ukrainian, Russian, Bulgarian, Hungarian, Turkish, Greek, Norwegian, Czech, Japanese, Polish, Swedish, Traditional Chinese, Romanian, Finnish, Dutch, Portuguese - Brazil, Portuguese - Portugal, Spanish - Latin America, Vietnamese, Korean, Indonesian, Malay", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4209370/e41f9368a815e7400ceb131f9cc5dbe63df88ffb/header.jpg?t=1788269553", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4209370/6a75fd9ebca45c58a088c4d945d673d71bde289d/capsule_231x87.jpg?t=1788269553", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4209370/6a75fd9ebca45c58a088c4d945d673d71bde289d/capsule_184x69.jpg?t=1788269553", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10/11<br></li><li><strong>Processor:</strong> INTEL CORE I5-8400 or AMD RYZEN 3 3300Ｘ<br></li><li><strong>Graphics:</strong> NVIDIA GeForce GTX 1060 3GB or AMD Radeon RX 570 4GB<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 5 GB available space</li></ul>", "recommended": "<strong>R