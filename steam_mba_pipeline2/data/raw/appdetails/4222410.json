ai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/ff45e379565d8ccc786ca35672e5f565.mp4?t=1775397315\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>GUN STORE</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/d250666915b55ee1c29e89d08677305e.poster.avif?t=1775397315\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/d250666915b55ee1c29e89d08677305e.webm?t=1775397315\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/d250666915b55ee1c29e89d08677305e.mp4?t=1775397315\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>SWITCH CHARACTERS AT ANY TIME</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/0a4011e3fd7385c2b5789635a33ac631.poster.avif?t=1775397315\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/0a4011e3fd7385c2b5789635a33ac631.webm?t=1775397315\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/0a4011e3fd7385c2b5789635a33ac631.mp4?t=1775397315\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>MANAGE YOUR ARSENAL IN THE WEAPON MENU</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/97799bc14d5587f8565a73c9e2347131.poster.avif?t=1775397315\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/97799bc14d5587f8565a73c9e2347131.webm?t=1775397315\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4222410/extras/97799bc14d5587f8565a73c9e2347131.mp4?t=1775397315\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >📘 <strong>STORY MODE: FROM THE OUTSKIRTS TO THE TOP (IN DEVELOPMENT)</strong></h2><p class=\"bb_paragraph\" >In Story Mode, you play as a low-income protagonist living in the outskirts, struggling every day to survive and change your life. With limited opportunities and a harsh reality, you’ll have to choose: <strong>follow the path of honesty… or dive into crime to reach your goals?</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Legal and illegal jobs</p></li><li><p class=\"bb_paragraph\" >Missions that reflect the weight of your decisions</p></li><li><p class=\"bb_paragraph\" >A challenging journey of social ascent<br>Every choice shapes your path in <strong>Sunset Hustle City</strong>, a vibrant metropolis that doesn’t forgive the weak.</p></li></ul><h2 class=\"bb_tag\" >🚗 <strong>A CITY FULL OF LIFE</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Dynamic traffic</p></li><li><p class=\"bb_paragraph\" >Pedestrians</p></li><li><p class=\"bb_paragraph\" >Diverse environments, from the outskirts to upper-class districts</p></li><li><p class=\"bb_paragraph\" >Shops, weapons, cars, alleys, and dangerous areas</p></li><li><p class=\"bb_paragraph\" >Dynamic weather (sun, rain, snow, storms, and more)</p></li></ul>", "about_the_game": "<p class=\"bb_paragraph\" ><strong>Sunset Crime</strong> is an open-world game inspired by the great classics of the urban crime genre. Here, you’re free to make your own choices, and deal with the consequences. Explore a living, chaotic city ful