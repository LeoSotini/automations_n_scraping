hared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/dc5855c94f757d5e00231fdeefa1cd9f.poster.avif?t=1785852820\" width=600 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/dc5855c94f757d5e00231fdeefa1cd9f.webm?t=1785852820\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/dc5855c94f757d5e00231fdeefa1cd9f.mp4?t=1785852820\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/76f9a310703cfd3bc6dd39953755ba90.poster.avif?t=1785852820\" width=600 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/76f9a310703cfd3bc6dd39953755ba90.webm?t=1785852820\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/76f9a310703cfd3bc6dd39953755ba90.mp4?t=1785852820\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Or even eat bananas and spit the peels so other giraffes (or yourself) will slip on them.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/e2a255e970484828981c5eb9430a1f28.poster.avif?t=1785852820\" width=600 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/e2a255e970484828981c5eb9430a1f28.webm?t=1785852820\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/e2a255e970484828981c5eb9430a1f28.mp4?t=1785852820\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><vid