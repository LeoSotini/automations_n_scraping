50/extras/4a0e3d3c7b4176210d5fab5100b332dd.mp4?t=1785852820\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >What about farting? How fast can you go?</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/ebd078a31f668aa3fea32ed7e4a144e6.poster.avif?t=1785852820\" width=600 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/ebd078a31f668aa3fea32ed7e4a144e6.webm?t=1785852820\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/ebd078a31f668aa3fea32ed7e4a144e6.mp4?t=1785852820\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Features:</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Racing giraffes</p></li><li><p class=\"bb_paragraph\" >Pooping giraffes</p></li><li><p class=\"bb_paragraph\" >Slipping giraffes</p></li><li><p class=\"bb_paragraph\" >Farting giraffes</p></li><li><p class=\"bb_paragraph\" >Up to eight (nine?) players in the same PvP race... Possibly a lot more!</p></li><li><p class=\"bb_paragraph\" >Colorful pixel art graphics</p></li><li><p class=\"bb_paragraph\" >Nostalgic eight-bit music and sound effects</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/aec95198c5a4eda6ed36192b1e8bf546.poster.avif?t=1785852820\" width=800 height=150 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/aec95198c5a4eda6ed36192b1e8bf546.webm?t=1785852820\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4260550/extras/aec95198c5a4eda6ed36192b1e8bf546.mp4?t=1785852820\" type=\"video/mp4