3424.webm?t=1783335787\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4311530/extras/758cb1ab2478d7d18786bbbec9493424.mp4?t=1783335787\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Open the gates. Sell the tickets. Pretend everything is fine.</p><p class=\"bb_paragraph\" >Behind the scenes?</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Dinosaurs are getting hungry</p></li><li><p class=\"bb_paragraph\" >Guests are getting annoying</p></li><li><p class=\"bb_paragraph\" >Systems are definitely failing</p></li></ul><p class=\"bb_paragraph\" >Keep the park running, or watch it spiral into a very expensive mistake.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4311530/extras/a998e07249fea0de272bdb66a7188b33.webp?t=1783335787\" width=780 height=53 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4311530/extras/90f81b8828202e4155960cad31b4052c.poster.avif?t=1783335787\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4311530/extras/90f81b8828202e4155960cad31b4052c.webm?t=1783335787\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4311530/extras/90f81b8828202e4155960cad31b4052c.mp4?t=1783335787\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Your dinosaurs are incredible, majestic and constantly seconds away from ruining your life.</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Step into enclosures to feed and manage them</p></li><li><p class=\"bb_paragraph\" >Clean up mountains of poop</p></li><li><p class=\"bb_paragraph\" >