{"4314050": {"success": true, "data": {"type": "game", "name": "Soul Scroll", "steam_appid": 4314050, "required_age": 0, "is_free": true, "detailed_description": "<p class=\"bb_paragraph\" ><strong>Soulscroll</strong> is a survival and settlement-building game set in a procedurally generated fantasy wilderness. You start with nothing and gather resources to build your settlement step by step. By expanding your base, managing your resources, and defeating dangerous monsters, you grow stronger over time — with one ultimate goal: to face and defeat the <strong>final boss</strong>.</p><p class=\"bb_paragraph\" ><strong>Features</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Procedurally generated world with biomes and rivers</p></li><li><p class=\"bb_paragraph\" >Gather resources and grow your settlement</p></li><li><p class=\"bb_paragraph\" >Place and upgrade buildings to expand your village</p></li><li><p class=\"bb_paragraph\" >Fight monsters and progress through upgrades and stronger gear</p></li><li><p class=\"bb_paragraph\" >Endgame goal: find and defeat the final boss</p></li></ul><p class=\"bb_paragraph\" ><strong>Note:</strong> This is an early test version currently intended only for selected players. Content, balance, and performance are actively being improved and expanded.</p>", "about_the_game": "<p class=\"bb_paragraph\" ><strong>Soulscroll</strong> is a survival and settlement-building game set in a procedurally generated fantasy wilderness. You start with nothing and gather resources to build your settlement step by step. By expanding your base, managing your resources, and defeating dangerous monsters, you grow stronger over time — with one ultimate goal: to face and defeat the <strong>final boss</strong>.</p><p class=\"bb_paragraph\" ><strong>Features</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Procedurally generated world with biomes and rivers</p></li><li><p class=\"bb_paragraph\" >Gather resources and grow your settlement</p></li><li><p class=\"bb_paragraph\" >Place and upgrade buildings to expand your village</p></li><li><p class=\"bb_paragraph\" >Fight monsters and progress through upgrades and stronger gear</p></li><li><p class=\"bb_paragraph\" >Endgame goal: find and defeat the final boss</p></li></ul><p class=\"bb_paragraph\" ><strong>Note:</strong> This is an early test version currently intended only for selected players. Content, balance, and performance are actively being improved and expanded.</p>", "short_description": "Soulscroll is a fantasy action roguelite where every run begins with gathering, building, fighting and surviving. Collect scroll currency during your runs, open chests in the main menu, and choose whether to use your rewards in future runs or offer them on the Steam Market.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4314050/9058618e4d44130676145748c4f08b22e66790f3/header.jpg?t=1787581501", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4314050/6f4222e7a9fc27d2df78e6196c34d21fd4e359c4/capsule_231x87.jpg?t=1787581501", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4314050/6f4222e7a9fc27d2df78e6196c34d21fd4e359c4/capsule_184x69.jpg?t=1787581501", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Win11</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Win11</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Literzz"], "publishers": ["Literzz"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 1, "description": "Multi-player"}, {"id": 9, "description": "Co-op"}, {"id": 38, "de