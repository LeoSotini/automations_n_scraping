haring"}], "genres": [{"id": "9", "description": "Racing"}, {"id": "28", "description": "Simulation"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/cdc31078a00da753c9fac51c6160eca5602669db/ss_cdc31078a00da753c9fac51c6160eca5602669db.600x338.jpg?t=1782338666", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/cdc31078a00da753c9fac51c6160eca5602669db/ss_cdc31078a00da753c9fac51c6160eca5602669db.1920x1080.jpg?t=1782338666"}, {"id": 1, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/62f3f5d33446b632f63a17e3acd63d7ae1772312/ss_62f3f5d33446b632f63a17e3acd63d7ae1772312.600x338.jpg?t=1782338666", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/62f3f5d33446b632f63a17e3acd63d7ae1772312/ss_62f3f5d33446b632f63a17e3acd63d7ae1772312.1920x1080.jpg?t=1782338666"}, {"id": 2, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/5a8657e0f33cc227e76cf76f67d8d1339202fb5f/ss_5a8657e0f33cc227e76cf76f67d8d1339202fb5f.600x338.jpg?t=1782338666", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/5a8657e0f33cc227e76cf76f67d8d1339202fb5f/ss_5a8657e0f33cc227e76cf76f67d8d1339202fb5f.1920x1080.jpg?t=1782338666"}, {"id": 3, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/ff3c9ce3a24dc1bdd5f82b1df607691209b6a298/ss_ff3c9ce3a24dc1bdd5f82b1df607691209b6a298.600x338.jpg?t=1782338666", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/ff3c9ce3a24dc1bdd5f82b1df607691209b6a298/ss_ff3c9ce3a24dc1bdd5f82b1df607691209b6a298.1920x1080.jpg?t=1782338666"}, {"id": 4, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4350410/ec33d65e699f4880d84a687dc2300a7619111a88/ss_ec33d65e699f4880d84a687dc2300a7619111a88.600x338.jpg