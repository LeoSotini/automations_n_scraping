{"4386140": {"success": true, "data": {"type": "game", "name": "Arrow Hell", "steam_appid": 4386140, "required_age": 0, "is_free": false, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" >You are a magical/mystical Arrow flying &amp; fighting in the Space for your Survival. Fight and Upgrade yourself for the next enemies being unlocked in upcoming levels.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Enemies hunt you down, surround you, and fire relentlessly — forcing you to dodge and strike-back with precision. Master movement, timing, and quick reactions to survive escalating waves and overwhelming odds.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Simple controls. Tight gameplay. Pure action.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Fast-paced top-down shooter combat</p></li><li><p class=\"bb_paragraph\" >Slash and shoot mechanics</p></li><li><p class=\"bb_paragraph\" >Aggressive enemy AI that chases and attacks</p></li><li><p class=\"bb_paragraph\" >Skill-based dodging and positioning</p></li><li><p class=\"bb_paragraph\" >Classic arcade survival challenge</p></li></ul>", "about_the_game": "<p class=\"bb_paragraph\" >You are a magical/mystical Arrow flying &amp; fighting in the Space for your Survival. Fight and Upgrade yourself for the next enemies being unlocked in upcoming levels.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Enemies hunt you down, surround you, and fire relentlessly — forcing you to dodge and strike-back with precision. Master movement, timing, and quick reactions to survive escalating waves and overwhelming odds.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Simple controls. Tight gameplay. Pure action.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Fast-paced top-down shooter combat</p></li><li><p class=\"bb_paragraph\" >Slash and shoot mechanics</p></li><li><p class=\"bb_paragraph\" >Aggressive enemy AI that chases and attacks</p></li><li><p class=\"bb_paragraph\" >Skill-based dodging and positioning</p></li><li><p class=\"bb_paragraph\" >Classic arcade survival challenge</p></li></ul>", "short_description": "Play as a Magical Arrow and Fight for your Survival in the Space. A fast-paced arcade game packed with relentless and sci-fi enemy waves. Dodge, Attack &amp; Upgrade and stand until the end in this Short &amp; Minimally Designed Action Arena.", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4386140/6076b7335c8e8304c7ee02944d4340df24624a85/header.jpg?t=1787509443", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4386140/bdca72ab5a196d89c9ffb1bac3155165c12ee275/capsule_231x87.jpg?t=1787509443", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4386140/bdca72ab5a196d89c9ffb1bac3155165c12ee275/capsule_184x69.jpg?t=1787509443", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3-6100 / AMD FX-6300<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 530 / AMD Radeon R7 250<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Afzal Ansari"], "publishers": ["Afzal Ansari"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 28, "description": "Full controller support"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "1", "description": "A