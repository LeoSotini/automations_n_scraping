er=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4429970/extras/fed84ffa360cb801a4b1fcbe17746861.poster.avif?t=1786156808\" width=776 height=438 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4429970/extras/fed84ffa360cb801a4b1fcbe17746861.webm?t=1786156808\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4429970/extras/fed84ffa360cb801a4b1fcbe17746861.mp4?t=1786156808\" type=\"video/mp4\"></video></span></p>", "short_description": "A world of discovery, existing in perfect harmony, broken from the destructive powers of Chaos. Explore lush forests, battle chaotic monsters, make friends and memories, and power yourself up for a big adventure, while still being silly.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4429970/965c1064f68ec8f18d9e4c2588a888568ea6f53c/header.jpg?t=1786156808", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4429970/4dc2d5298afbeee03db888054562836edf24e8ee/capsule_231x87.jpg?t=1786156808", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4429970/4dc2d5298afbeee03db888054562836edf24e8ee/capsule_184x69.jpg?t=1786156808", "website": "https://visioneternal.net", "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3-3240, AMD FX-4300<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 560 Ti (1GB), Radeon HD 7750 (1GB)<br></li><li><strong>DirectX:</strong> Version 10<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"}, "mac_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Big Sur 11 or newer<br></li><li><strong>Processor:</strong> Intel Core i3<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Metal capable Intel and AMD GPUs<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"}, "linux_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 22.04, Ubuntu 24.04 (64bit)<br></li><li><strong>Processor:</strong> Intel Core i3-3240, AMD FX-4300<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GeForce GTX 560 Ti (1GB), Radeon HD 7750 (1GB)<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"}, "developers": ["Visioneternal"], "publishers": ["Visioneternal"], "package_groups": [], "platforms": {"windows": true, "mac": true, "linux": true}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 22, "description": "Steam Achievements"}, {"id": 28, "description": "Full controller support"}, {"id": 68, "description": "Custom Volume Controls"}, {"id": 60, "description": "Gamepad Recommended"}, {"id": 74, "description": "Playable without Timed Input"}, {"id": 55, "description": "DualShock Controller Support"}, {"id": 56, "description": "DualShock Controller Support"}, {"id": 57, "description": "DualSense Controller Support"}, {"id": 58, "description": "DualSense Controller Support"}, {"id": 69, "description": "Stereo Sound"}, {"id": 23, "description": "Steam Cloud"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "1", "description": "Action"}, {"id": "25", "description": "Adventure"}, {"id": "23", "description": "Indie"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4429970/d590aa5b3daf7b1a30ae424e623faac8640b4fb8/ss_d590aa5b3daf7b1a30ae424e623faac8640b4fb8.600x338.jpg?t=1786156808", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4429970/d590aa5b3daf7b1a30ae424e623faac86