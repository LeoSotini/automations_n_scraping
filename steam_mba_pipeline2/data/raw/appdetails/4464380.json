m/store_item_assets/steam/apps/4464380/0cfda62d7f743109ba84f956d6275443b3f3253e/ss_0cfda62d7f743109ba84f956d6275443b3f3253e.1920x1080.jpg?t=1775328733"}], "movies": [{"id": 257299813, "name": "Stellar Fixer Teaser", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257299813/f06de4715f89b4ceea5268459e2f80e965ef19ff/movie_600x337.jpg?t=1773170235", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/4464380/197183674/59ef577cf3dde8939f4a7eb38cc070afe50b4f5d/1772979955/dash_av1.mpd?t=1773170235", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/4464380/197183674/59ef577cf3dde8939f4a7eb38cc070afe50b4f5d/1772979955/dash_h264.mpd?t=1773170235", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/4464380/197183674/59ef577cf3dde8939f4a7eb38cc070afe50b4f5d/1772979955/hls_264_master.m3u8?t=1773170235", "highlight": true}], "release_date": {"coming_soon": true, "date": "2026"}, "support_info": {"url": "", "email": "silent.satellite.games@gmail.com"}, "background": "https://store.akamai.steamstatic.com/images/storepagebackground/app/4464380?t=1775328733", "background_raw": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4464380/3f3e36a5bab02ba26743cb8c81fe4767b525713b/page_bg_raw.jpg?t=1775328733", "content_descriptors": {"ids": [], "notes": null}, "ratings": {"dejus": {"rating_generated": "1", "rating": "10", "required_age": "10", "banned": "0", "use_age_gate": "0", "descriptors": "Medo"}, "steam_germany": {"rating_generated": "1", "rating": "6", "required_age": "6", "banned": "0", "use_age_gate": "0", "descriptors": "Ängstigende Inhalte"}, "igrs": {"rating_generated": "1", "rating": "18", "required_age": "18", "banned": "0", "use_age_gate": "0", "descriptors": "Horor"}}}}}