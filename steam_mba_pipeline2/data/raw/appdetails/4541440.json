a36297f.webm?t=1782632637\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4541440/extras/2a1531a0928755b002d507815a36297f.mp4?t=1782632637\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Guide the Fish To Advance</strong></h2><p class=\"bb_paragraph\" >With a drum scavenged from the shore, you must escort this blind fish through a system that exceeds your comprehension. The Blind Fish cannot tell you where to go, but keeping it alive and in water is the key to navigating this unfamiliar place – just be careful not to fall into the water and return to that deep sleep...</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4541440/extras/f160a618b57bec4eaa2b79fb45e7e85e.poster.avif?t=1782632637\" width=622 height=350 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4541440/extras/f160a618b57bec4eaa2b79fb45e7e85e.webm?t=1782632637\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4541440/extras/f160a618b57bec4eaa2b79fb45e7e85e.mp4?t=1782632637\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Everything Around You Contains a Clue</strong></h2><p class=\"bb_paragraph\" >These unlikely companions embark on a journey to escape death — navigating the vast machinery of the afterlife, befriending the caretakers of this place, and uncovering who they were. The story of their relationship will carry you through an emotional landscape of what lies beyond life: attachment, dependence, and letting go.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4541440/extras/7b037d8657c283de559231e5325c9af1.poster.av