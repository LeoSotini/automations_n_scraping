c.poster.avif?t=1787702447\" width=800 height=312 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4549600/extras/2c228432661c6fef7cfc09c092f3577c.webm?t=1787702447\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4549600/extras/2c228432661c6fef7cfc09c092f3577c.mp4?t=1787702447\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "short_description": "A chaotic multiplayer skating game where each player controls one skate! Only epic teamwork and swift communication will get you through the brutal obstacle course! Dodge the blades, jump the canyons, and avoid the lava, because one mistake sends you all the way back.", "supported_languages": "English<strong>*</strong>, Japanese<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4549600/108deb86d607757f44fb53987d0adf108a67e069/header.jpg?t=1787702447", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4549600/3cfef5531d2b15f194d7eb8cd00c53bb566d0ad2/capsule_231x87.jpg?t=1787702447", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4549600/3cfef5531d2b15f194d7eb8cd00c53bb566d0ad2/capsule_184x69.jpg?t=1787702447", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i3-6100 / AMD FX-6300<br></li><li><strong>Memory:</strong> 6 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 750 Ti / AMD Radeon R7 260X<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 4 GB available space</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_