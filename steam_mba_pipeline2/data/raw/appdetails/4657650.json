4b2a3d8b89f489c046b498cfa.poster.avif?t=1786719916\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657650/extras/6c32fcd4b2a3d8b89f489c046b498cfa.webm?t=1786719916\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657650/extras/6c32fcd4b2a3d8b89f489c046b498cfa.mp4?t=1786719916\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>DISCOVER THE SECRETS OF DAIMIENS</strong></h2><p class=\"bb_paragraph\" >Consult the Witch’s Journal, collect relics and ingredients, open card packs and complete your collectible card album. Explore special locations, uncover hidden secrets and visit the unsettling shop of the mysterious Merchant Donoso.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657650/extras/e4ddee1da5919a05b023341019736ae9.poster.avif?t=1786719916\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657650/extras/e4ddee1da5919a05b023341019736ae9.webm?t=1786719916\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657650/extras/e4ddee1da5919a05b023341019736ae9.mp4?t=1786719916\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>INSPIRED BY THE LEGENDS OF DAIMIEL</strong></h2><p class=\"bb_paragraph\" >Daimiens: Town of Witches is a dark fantasy work freely inspired by the folklore, legends and certain historical elements of Daimiel, a real town in Ciudad Real, Spain, traditionally known as “the town of witches.”</p><p class=\"bb_paragraph\" >Daimiens, its characters, organizations and events belong to a fictional universe created for the video game. The game is not intended to accurately reproduce the history of Daimiel, nor to represent, judge or offend its inhabitants, institutions or beliefs.</p><p class=\"bb_paragraph\" >This project was born as a personal tribute to the legends, culture and places of its creator’s homeland.</p>", "short_description": "Open a cursed book and awaken as a witch in a dark 18th-century world. Fight with sword and magic, brew potions, complete rituals, collect cards, transform your body and summon mystical animal companions while uncovering a story that crosses time.", "supported_languages": "Spanish - Spain, English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657650/7e8da4394154e47563a2454142be212acf4023c4/header.jpg?t=1786719916", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657650/12f6345cbd819e043d7e90d0b58ef860973dacd4/capsule_231x87.jpg?t=1786719916", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657650/12f6345cbd819e043d7e90d0b58ef860973dacd4/capsule_184x69.jpg?t=1786719916", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 (64-bit)<br></li><li><strong>Processor:</strong> Dual Core 2.0 GHz<br></li><li><strong>Memory:</strong> 2048 MB MB RAM<br></li><li><strong>Graphics:</strong> DirectX 11 compatible graphics card<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 900 MB available space</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system</li></ul>"}, "mac_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"></ul>"}, "linux_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"></ul