{"4657970": {"success": true, "data": {"type": "game", "name": "Nonsense Football Club", "steam_appid": 4657970, "required_age": 0, "is_free": false, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" ><strong>Where classic football fundamentals meet absolute chaos.</strong> In <strong>Nonsense Football Club</strong>, the ball is your ultimate tool for survival!</p><p class=\"bb_paragraph\" >Embark on an intense journey divided into <strong>3 evolving acts</strong>, where every football fundamental — from defense to attack — is pushed to its absolute limit in increasingly unpredictable challenges.</p><h2 class=\"bb_tag\" ><strong>Key Features:</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>The Art of Defense:</strong> Forget playing clean. Use precise slide tackles, aerial interceptions, and quick-reaction headers to stop your opponents.</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Midfield Vision:</strong> Point, aim, and calculate the pass ahead! Test your precision by destroying high-speed threats and delivering perfect lead passes to score.</p></li><li><p class=\"bb_paragraph\" ><strong>Devastating Attack:</strong> Show off your 1v1 skills! Master the timing of classic dribbles — like stepovers, elasticos — to slice through ruthless defenses before blasting the ball into the back of the net.</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Chaotic Boss Battles:</strong> Face colossal threats, combining everything you've learned to walk off the pitch with a victory.</p></li></ul><h2 class=\"bb_tag\" ><strong>Game Highlights:</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Reimagined Football:</strong> Classic football mechanics reinterpreted as a stage-based action game.</p></li><li><p class=\"bb_paragraph\" ><strong>Creative Progression:</strong> A structured learning curve broken down by pitch sectors: Defense, Midfield, and Attack.</p></li><li><p class=\"bb_paragraph\" ><strong>Precision &amp; Timing:</strong> Responsive controls designed to reward precise timing for every pass, tackle, and dribble.</p><p class=\"bb_paragraph\" ></p></li></ul>", "about_the_game": "<p class=\"bb_paragraph\" ><strong>Where classic football fundamentals meet absolute chaos.</strong> In <strong>Nonsense Football Club</strong>, the ball is your ultimate tool for survival!</p><p class=\"bb_paragraph\" >Embark on an intense journey divided into <strong>3 evolving acts</strong>, where every football fundamental — from defense to attack — is pushed to its absolute limit in increasingly unpredictable challenges.</p><h2 class=\"bb_tag\" ><strong>Key Features:</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>The Art of Defense:</strong> Forget playing clean. Use precise slide tackles, aerial interceptions, and quick-reaction headers to stop your opponents.</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Midfield Vision:</strong> Point, aim, and calculate the pass ahead! Test your precision by destroying high-speed threats and delivering perfect lead passes to score.</p></li><li><p class=\"bb_paragraph\" ><strong>Devastating Attack:</strong> Show off your 1v1 skills! Master the timing of classic dribbles — like stepovers, elasticos — to slice through ruthless defenses before blasting the ball into the back of the net.</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Chaotic Boss Battles:</strong> Face colossal threats, combining everything you've learned to walk off the pitch with a victory.</p></li></ul><h2 class=\"bb_tag\" ><strong>Game Highlights:</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Reimagined Football:</strong> Classic football mechanics reinterpreted as a stage-based action game.</p></li><li><p class=\"bb_paragraph\" ><strong>Creative Progression:</strong> A structured learning curve broken down by pitch sectors: Defense, Midfield, and Attack.</p></li><li><p class=\"bb_paragraph\" ><strong>Precision &amp; Timing:</strong> Responsive controls designed to reward precise timing for every pass, tackle, and dribble.</p><p class=\"bb_paragraph\" ></p></li></ul>", "short_description": "Nonsense Football Club is a 3D action football game where core football fundamentals become combat mechanics! Master the timing of slide tackles, precision passing, and skill moves to defeat defeat unconventional teams like robots, fantastical creatures, and insane bosses!", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657970/068d5348c087d24bff8806af89c44c53be8f1f36/header.jpg?t=1786717047", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657970/45873f20490f083aaa0fef8f1232e3cff2bdf8b4/capsule_231x87.jpg?t=1786717047", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4657970/45873f20490f083aaa0fef8f1232e3cff2bdf8b4/capsule_184x69.jpg?t=1786717047", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 and above<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> RX 580 or above</li></ul>", "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 and above<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> RTX 3060</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["SoloDevTeam"], "publishers": ["SoloDevTeam"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 28, "description": "Full controller support"}, {"id": 68, "description": "Custom Volume Controls"}, {"id": 74, "description": "Playable without Timed Input"}, {"id": 23, "description