080.jpg?t=1785000545"}, {"id": 4, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4703930/b664788659defffe426f1845566c858404ce2913/ss_b664788659defffe426f1845566c858404ce2913.600x338.jpg?t=1785000545", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4703930/b664788659defffe426f1845566c858404ce2913/ss_b664788659defffe426f1845566c858404ce2913.1920x1080.jpg?t=1785000545"}, {"id": 5, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4703930/8f2015bfd72821ba828c1541a94941e13a1046d1/ss_8f2015bfd72821ba828c1541a94941e13a1046d1.600x338.jpg?t=1785000545", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4703930/8f2015bfd72821ba828c1541a94941e13a1046d1/ss_8f2015bfd72821ba828c1541a94941e13a1046d1.1920x1080.jpg?t=1785000545"}], "movies": [{"id": 257340162, "name": "Grilluminati - Official Announcement Trailer", "thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257340162/d24402dc704a2cfd291507b157ef2bac1fb7aa31/movie_600x337.jpg?t=1779287223", "dash_av1": "https://video.akamai.steamstatic.com/store_trailers/4703930/187068037/20d4d48d086bc5d3ff19fea43851dbf9cb53adc8/1779286678/dash_av1.mpd?t=1779287223", "dash_h264": "https://video.akamai.steamstatic.com/store_trailers/4703930/187068037/20d4d48d086bc5d3ff19fea43851dbf9cb53adc8/1779286678/dash_h264.mpd?t=1779287223", "hls_h264": "https://video.akamai.steamstatic.com/store_trailers/4703930/187068037/20d4d48d086bc5d3ff19fea43851dbf9cb53adc8/1779286678/hls_264_master.m3u8?t=1779287223", "highlight": true}], "release_date": {"coming_soon": true, "date": "Q4 2026"}, "support_info": {"url": "https://www.anaxanthia.com", "email": ""}, "background": "https://store.akamai.steamstatic.com/images/storepagebackground/app/4703930?t=1785000545", "background_raw": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4703930/2de0aa3ed0895fc114f4339146dab3fe262991c9/page_bg_raw.jpg?t=1785000545", "content_descriptors": {"ids": [5], "notes": "This game contains stylized depictions of violence and dark humor. Players take on the role of cult members who isolate and kill customers as part of ritual sacrifices. Bodies may be dismembered or processed into “ingredients,” and players may need to clean up blood or other evidence.\r\n\r\nViolence is presented in a non-realistic, cartoon-like style and is often framed in an absurd or comedic tone. The game may also include themes of cult activity, ritual sacrifice, and occasional betrayal between players (such as sacrificing a teammate as part of a ritual).\r\n\r\nThere is no depiction of sexual acts or sexual violence."}, "ratings": {"dejus": {"rating_generated": "1", "rating": "12", "required_age": "12", "banned": "0", "use_age_gate": "0", "descriptors": "Violência\nAtos criminosos"}, "steam_germany": {"rating_generated": "1", "rating": "16", "required_age": "16", "banned": "0", "use_age_gate": "0", "descriptors": "Gewalt"}, "igrs": {"rating_generated": "1", "rating": "15", "required_age": "15", "banned": "0", "use_age_gate": "0", "descriptors": "Penggunaan bahasa\nKekerasan"}}}}}