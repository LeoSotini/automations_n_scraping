p9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/9cf3d88fcb04766e02701327e1749ff4.mp4?t=1788180740\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/184ab0bc69ff3e2c624e79aec0ccdb4f.avif?t=1788180740\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras_big/184ab0bc69ff3e2c624e79aec0ccdb4f.webp?t=1788180740 width=1560 height=166 /></span></h2><p class=\"bb_paragraph\" style=\"text-align: center\">Our game is mainly designed for two players, where you need to cooperate and keep the kitchen running smoothly.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">Also playable solo, with fewer customers and adjusted difficulty, but the story stays the same!</p><h2 class=\"bb_tag\" style=\"text-align: center\"></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/f1611e33f40dc83e1af1e51434c4c1a8.poster.avif?t=1788180740\" width=1170 height=492 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/f1611e33f40dc83e1af1e51434c4c1a8.webm?t=1788180740\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/f1611e33f40dc83e1af1e51434c4c1a8.mp4?t=1788180740\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/90d560a62cdd86d69b600ebded69651d.avif?t=1788180740\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras_big/90d560a62cdd86d69b600ebded69651d.webp?t=1788180740 width=1560 height=166 /></span></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">As a true professional, you must prepare everything before the customers arrive and the rush begins. Chop your vegetables, prepare your stock, bake your bread.</p><p class=\"bb_paragraph\" style=\"text-align: center\">Once the rush starts, there is no time to waste!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/7a26328d4a9a12de536ff67cd6217836.poster.avif?t=1788180740\" width=1170 height=492 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/7a26328d4a9a12de536ff67cd6217836.webm?t=1788180740\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/7a26328d4a9a12de536ff67cd6217836.mp4?t=1788180740\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/3036d0992ae749ff4746d70901658eb7.avif?t=1788180740\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras_big/3036d0992ae749ff4746d70901658eb7.webp?t=1788180740 width=1560 height=166 /></span></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">Serve every course precisely timed. Every meal has its perfect serving moment. Manage your orders, maintain the pacing, and don’t let your customers stay hungry for too long.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/368b813f6b608b394a57561788215b5b.poster.avif?t=1788180740\" width=1170 height=492 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/368b813f6b608b394a57561788215b5b.webm?t=1788180740\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/368b813f6b608b394a57561788215b5b.mp4?t=1788180740\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/c0a2ced85bf6554a867a3295f65b41b8.avif?t=1788180740\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras_big/c0a2ced85bf6554a867a3295f65b41b8.webp?t=1788180740 width=1560 height=166 /></span></h2><p class=\"bb_paragraph\" style=\"text-align: center\"></p><p class=\"bb_paragraph\" style=\"text-align: center\">Hungry guests are waiting. Time your dishes perfectly, not a second too soon or too late. Every mistake costs you stars. Keep your rating high by staying precise.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/1f7ceb77d862c389212fed7f11c2aeda.poster.avif?t=1788180740\" width=1170 height=492 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/1f7ceb77d862c389212fed7f11c2aeda.webm?t=1788180740\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/1f7ceb77d862c389212fed7f11c2aeda.mp4?t=1788180740\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/4f7e2a28a387962f51efe9a5b0a6a7a3.avif?t=1788180740\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras_big/4f7e2a28a387962f51efe9a5b0a6a7a3.webp?t=1788180740 width=1560 height=166 /></span></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">Your nemesis will appear unexpectedly always at the worst moment. Be prepared at all times you will never know which order is his.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/7515e14993b90c8e2e0af7dd0ff822bd.poster.avif?t=1788180740\" width=1170 height=492 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/7515e14993b90c8e2e0af7dd0ff822bd.webm?t=1788180740\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/7515e14993b90c8e2e0af7dd0ff822bd.mp4?t=1788180740\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/375d5782e33cc0407a4f73efbfc2c742.avif?t=1788180740\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras_big/375d5782e33cc0407a4f73efbfc2c742.webp?t=1788180740 width=1560 height=166 /></span></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">Grandma’s journal leads your journey across the world. Learn from legendary chefs and grow into the chef you were meant to become.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/518b91f9946ab2c306657b645b363147.poster.avif?t=1788180740\" width=1170 height=492 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/518b91f9946ab2c306657b645b363147.webm?t=1788180740\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/518b91f9946ab2c306657b645b363147.mp4?t=1788180740\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"> </p><h2 class=\"bb_tag\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/985df5adb4688a86d499f5c8310defa8.avif?t=1788180740\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras_big/985df5adb4688a86d499f5c8310defa8.webp?t=1788180740 width=1560 height=166 /></span></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\">Add new recipes to your family cookbook and progress toward restoring your family’s legacy.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/f6e0ec8eb4b5f9b6453fc3d57ef83ddf.poster.avif?t=1788180740\" width=1170 height=492 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/f6e0ec8eb4b5f9b6453fc3d57ef83ddf.webm?t=1788180740\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/f6e0ec8eb4b5f9b6453fc3d57ef83ddf.mp4?t=1788180740\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras/3f5bb87540835e9e3e65927aa5c32b27.avif?t=1788180740\" data-big-src=https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/extras_big/3f5bb87540835e9e3e65927aa5c32b27.webp?t=1788180740 width=1560 height=330 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>", "short_description": "Cook your way around Europe in this cozy co-op kitchen adventure for one to two players. Prepare authentic regional dishes, keep your kitchen running smoothly, and manage busy restaurants across diverse European cultures and cuisines, while uncovering Grandma’s story behind her legendary restaurant.", "supported_languages": "English<strong>*</strong>, French, German, Simplified Chinese, Czech, Traditional Chinese, Spanish - Spain, Portuguese - Portugal<br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/17e209a3537bd63ca5844df7aba97e2eb5ff38c3/header.jpg?t=1788180740", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/0994cac2a47c8b3cebf6bbb50075a28c774efa4b/capsule_231x87.jpg?t=1788180740", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4709130/0994cac2a47c8b3cebf6bbb50075a28c774efa4b/capsule_184x69.jpg?t=1788180740", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS *:</strong> Windows 7 (32-bit)<br></li><li><strong>Processor:</strong> Dual Core 2.4Ghz<br></li><li><strong>Memory:</strong> 2 GB RAM<br></li><li><strong>Graphics:</strong> GeForce 8800 GT / AMD HD 6850 / Intel HD Graphics 4400 or above<br></li><li><strong>Direc