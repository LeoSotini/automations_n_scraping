83425363", "content_descriptors": {"ids": [2, 5], "notes": "This game contains moderate violence and horror themes. Players can attack, injure, incapacitate, execute, or kill other characters during gameplay. Some Werewolf abilities feature grab and mauling animations, as well as killings performed as part of the gameplay cycle.\r\n\r\nThe game includes hangings, suffocation of incapacitated characters, public trials, pursuit by a supernatural creature, werewolf transformations, and elements of psychological suspense related to social deduction and betrayal among players.\r\n\r\nThere are also references to alcohol consumption in the village tavern, as well as the use of poisons and potions as gameplay mechanics.\r\n\r\nThe game does not contain sexual content, nudity, or depictions of sexual acts."}, "ratings": {"dejus": {"rating_generated": "1", "rating": "16", "required_age": "16", "banned": "0", "use_age_gate": "0", "descriptors": "Violência Extrema\nLinguagem imprópria\nAtos criminosos"}, "steam_germany": {"rating_generated": "1", "rating": "18", "required_age": "18", "banned": "0", "use_age_gate": "0", "descriptors": "Drastische Gewalt\nDerbe Sprache"}, "igrs": {"rating_generated": "1", "rating": "18", "required_age": "18", "banned": "0", "use_age_gate": "0", "descriptors": "Interaksi Daring\nKekerasan\nHoror"}}}}}