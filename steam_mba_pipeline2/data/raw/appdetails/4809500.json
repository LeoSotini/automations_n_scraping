lass=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4809500/extras/ebf2cb3a4e41cdcead8da0213b39d722.poster.avif?t=1787172639\" width=874 height=492 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4809500/extras/ebf2cb3a4e41cdcead8da0213b39d722.webm?t=1787172639\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4809500/extras/ebf2cb3a4e41cdcead8da0213b39d722.mp4?t=1787172639\" type=\"video/mp4\"></video></span></p>", "short_description": "Hop and Marty are back in an all new Kart Racing game from Evilkookey games. Play as all your favourite characters from the Hop 'n' Marty and battle it out as you blast through the courses on your way to first place. Play alone or with friends and try to beat your best times.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4809500/01279ad324683e5d1fc6fe075c3a4176166c2f8b/header.jpg?t=1787172639", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4809500/c15156ac0127ffd4291b2a386749fb7e0d1f3da2/capsule_231x87.jpg?t=1787172639", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4809500/c15156ac0127ffd4291b2a386749fb7e0d1f3da2/capsule_184x69.jpg?t=1787172639", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel(R) Core i5<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel(R) HD Graphics 5500<br></li><li><strong>Storage:</strong> 300  MB available space<br></li><li><strong>Sound Card:</strong> Realtek HD Audio</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Evi