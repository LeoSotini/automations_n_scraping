{"4892890": {"success": true, "data": {"type": "game", "name": "Trainbound Tales", "steam_appid": 4892890, "required_age": 0, "is_free": false, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" >Trainbound Tales is an adventure game where you control a steam train that has just arrived to the continent Pyrocarda. You choose your path along the rails and explore the many different zones, towns, and challenges that you find along the way. During your travels you will encounter the locals that have different quests for you. They will then help you expand the rail network and reward you with upgrades.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Key features:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Drive your train along a big network of tracks.</p></li><li><p class=\"bb_paragraph\" >Deliver and help produce new types of cargo.</p></li><li><p class=\"bb_paragraph\" >Complete quests for the local inhabitants.</p></li><li><p class=\"bb_paragraph\" >Discover the many zones with unique environments.</p></li><li><p class=\"bb_paragraph\" >Complete challenges to expand the rail network and reach new areas.</p></li></ul>", "about_the_game": "<p class=\"bb_paragraph\" >Trainbound Tales is an adventure game where you control a steam train that has just arrived to the continent Pyrocarda. You choose your path along the rails and explore the many different zones, towns, and challenges that you find along the way. During your travels you will encounter the locals that have different quests for you. They will then help you expand the rail network and reward you with upgrades.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Key features:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Drive your train along a big network of tracks.</p></li><li><p class=\"bb_paragraph\" >Deliver and help produce new types of cargo.</p></li><li><p class=\"bb_paragraph\" >Complete quests for the local inhabitants.</p></li><li><p class=\"bb_paragraph\" >Discover the many zones with unique environments.</p></li><li><p class=\"bb_paragraph\" >Complete challenges to expand the rail network and reach new areas.</p></li></ul>", "short_description": "Ride along in this steam train adventure RPG where you play as a newly arrived locomotive. Discover a vast world, expand the rail network, help the locals, and uncover the story of the continent Pyrocarda. Along the way, you deliver cargo, upgrade your train and complete challenges.", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4892890/674a9bf750836e9da05ff582c2d774620defca33/header.jpg?t=1783668028", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4892890/98d25e57511830bfb914f56c249ad1f151d93bfe/capsule_231x87.jpg?t=1783668028", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4892890/98d25e57511830bfb914f56c249ad1f151d93bfe/capsule_184x69.jpg?t=1783668028", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> 10<br></li><li><strong>Processor:</strong> Intel or AMD at 2 GHz or better<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GTX 750 or better<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Ubuntu 16+<br></li><li><strong>Processor:</strong> Intel or AMD at 2 GHz or better<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> GTX 750 or better<br></li><li><strong>Storage:</strong> 1 GB available space</li></ul>"}, "developers": ["Esben Drage Klokkervoll"], "publishers": ["Esben Drage Klokkervoll"], "package_groups": [], "pla