{"4893040": {"success": true, "data": {"type": "game", "name": "Hyposolus", "steam_appid": 4893040, "required_age": 0, "is_free": false, "controller_support": "full", "dlc": [5012430], "detailed_description": "<p class=\"bb_paragraph\" >Hyposolus is a role playing game where you explore the world at the brink of collapse. Explore what remains of the world on the floating islands in the sky. Defeat the golems and machines left behind, collect their resources and level up, as you encounter tougher and tougher trials. Make your own build for the situation by selecting perks and a limited number of spells. Learn about how the collapse of civilization came to be and discover what remains.</p><p class=\"bb_paragraph\" ><strong>Fight</strong></p><p class=\"bb_paragraph\" >Decide if you should you use melee or cast spells from afar. Burst and enemy with single target damage or defeat a whole group with AoE spells.</p><p class=\"bb_paragraph\" >Balance the elements and learn each monster's weakness.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Loot</strong></p><p class=\"bb_paragraph\" >Collect loot from monsters to unlock new areas. Different enemies drop different things, so hunt for the loot you need.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Learn</strong></p><p class=\"bb_paragraph\" >Learn what happened to the world and where everyone went. Is there anything left?<br><br><br><strong>Explore</strong></p><p class=\"bb_paragraph\" >Find new spells, forgotten chests, new places and monsters by exploring the world.</p>", "about_the_game": "<p class=\"bb_paragraph\" >Hyposolus is a role playing game where you explore the world at the brink of collapse. Explore what remains of the world on the floating islands in the sky. Defeat the golems and machines left behind, collect their resources and level up, as you encounter tougher and tougher trials. Make your own build for the situation by selecting perks and a limited number of spells. Learn about how the collapse of civilization came to be and discover what remains.</p><p class=\"bb_paragraph\" ><strong>Fight</strong></p><p class=\"bb_paragraph\" >Decide if you should you use melee or cast spells from afar. Burst and enemy with single target damage or defeat a whole group with AoE spells.</p><p class=\"bb_paragraph\" >Balance the elements and learn each monster's weakness.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Loot</strong></p><p class=\"bb_paragraph\" >Collect loot from monsters to unlock new areas. Different enemies drop different things, so hunt for the loot you need.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Learn</strong></p><p class=\"bb_paragraph\" >Learn what happened to the world and where everyone went. Is there anything left?<br><br><br><strong>Explore</strong></p><p class=\"bb_paragraph\" >Find new spells, forgotten chests, new places and monsters by exploring the world.</p>", "short_description": "Hyposolus is an action role playing game with strategic elements. A long time has passed and the world is shattered. Experiment with different perks and spell combinations to defeat enemies. Explore the floating islands and discover the past. Reach the spirits calling for you.", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/101215e92e7bab1bd779a5fea7abe173e41afe39/header.jpg?t=1788280284", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/b3433b839ceb56777b83567dd695b3652c33055b/capsule_231x87.jpg?t=1788280284", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/b3433b839ceb56777b83567dd695b3652c33055b/capsule_184x69.jpg?t=1788280284", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> 12th Gen Intel® Core™ i5<br></li><li><strong>Memory:</strong> 16 MB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GeForce RTX 3060<br></li><li><strong>Storage:</strong> 2 GB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Amland Interactive"], "publishers": ["Amland Interactive"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 28, "description": "Full controller support"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "1", "description": "Action"}, {"id": "3", "description": "RPG"}, {"id": "2", "description": "Strategy"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/c6331957e2ccff1de27025c3c28dd6ef1b973102/ss_c6331957e2ccff1de27025c3c28dd6ef1b973102.600x338.jpg?t=1788280284", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/c6331957e2ccff1de27025c3c28dd6ef1b973102/ss_c6331957e2ccff1de27025c3c28dd6ef1b973102.1920x1080.jpg?t=1788280284"}, {"id": 1, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/0d7fd943e34a60727383ee32d2fd3c4cbcaf6cab/ss_0d7fd943e34a60727383ee32d2fd3c4cbcaf6cab.600x338.jpg?t=1788280284", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/0d7fd943e34a60727383ee32d2fd3c4cbcaf6cab/ss_0d7fd943e34a60727383ee32d2fd3c4cbcaf6cab.1920x1080.jpg?t=1788280284"}, {"id": 2, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/b7d71a682a8758fd6182329c36bf414352dafe20/ss_b7d71a682a8758fd6182329c36bf414352dafe20.600x338.jpg?t=1788280284", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4893040/b7d71a682a8758fd6182329c36bf414352dafe20/ss_b7d71a682a8758fd6182329c36bf414352dafe20.1920x1080.jpg?t=1788280284"}, {"id": 3, "path_thumbnail": 