{"4919770": {"success": true, "data": {"type": "game", "name": "Tally Man", "steam_appid": 4919770, "required_age": 0, "is_free": false, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" >You find yourself in an infinitely looping dungeon tasked with verifying the ledger.</p><p class=\"bb_paragraph\" >Count the skulls, ensure the count, and increase the tally to escape.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Tally Man is a short and casual scavenger hunt game that tests your memory and attention to detail.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Gameplay Features:</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Progress through an infinitely looping dungeon.</p></li><li><p class=\"bb_paragraph\" >Discover over 30 skull hiding spots that are randomly chosen.</p></li><li><p class=\"bb_paragraph\" >Test your memory and attention to detail to quickly verify proper counts.</p></li><li><p class=\"bb_paragraph\" >Progress through the correct gate to verify or challenge the ledger's count.</p></li><li><p class=\"bb_paragraph\" >Achieve 10 correct verifications to finally escape the dungeon.</p></li></ul><p class=\"bb_paragraph\" ></p>", "about_the_game": "<p class=\"bb_paragraph\" >You find yourself in an infinitely looping dungeon tasked with verifying the ledger.</p><p class=\"bb_paragraph\" >Count the skulls, ensure the count, and increase the tally to escape.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Tally Man is a short and casual scavenger hunt game that tests your memory and attention to detail.</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Gameplay Features:</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Progress through an infinitely looping dungeon.</p></li><li><p class=\"bb_paragraph\" >Discover over 30 skull hiding spots that are randomly chosen.</p></li><li><p class=\"bb_paragraph\" >Test your memory and attention to detail to quickly verify proper counts.</p></li><li><p class=\"bb_paragraph\" >Progress through the correct gate to verify or challenge the ledger's count.</p></li><li><p class=\"bb_paragraph\" >Achieve 10 correct verifications to finally escape the dungeon.</p></li></ul><p class=\"bb_paragraph\" ></p>", "short_description": "You find yourself in an infinitely looping dungeon tasked with verifying the ledger. Count the skulls, ensure the count, and increase the tally to escape.", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4919770/c2fd8a750e804254ba0d5ed2ae7ae6ddcc81e4ec/header.jpg?t=1785335080", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4919770/6c50c3253d0abaa12f01f140d01583d6cf2df838/capsule_231x87.jpg?t=1785335080", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4919770/6c50c3253d0abaa12f01f140d01583d6cf2df838/capsule_184x69.jpg?t=1785335080", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Intel Core i3 Dual Core<br></li><li><strong>Graphics:</strong> NVIDIA Geforce GTS 450 / AMD Radeon HD 5570<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Inner Realm Studios"], "publishers": ["Inner Realm Studios"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 28, "description": "Full controller support"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "4", "description": "Casual"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4919770/fdab281624946d9d1389a534a8e824ecc63c3ccb/ss_fdab2