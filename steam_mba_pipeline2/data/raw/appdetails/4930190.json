exual content, nudity, or depictions of drug use."}, "ratings": {"dejus": {"rating_generated": "1", "rating": "14", "required_age": "14", "banned": "0", "use_age_gate": "0", "descriptors": "Violência"}, "steam_germany": {"rating_generated": "1", "rating": "16", "required_age": "16", "banned": "0", "use_age_gate": "0", "descriptors": "Drastische Gewalt"}, "igrs": {"rating_generated": "1", "rating": "18", "required_age": "18", "banned": "0", "use_age_gate": "0", "descriptors": "Kekerasan\nHoror"}}}}}