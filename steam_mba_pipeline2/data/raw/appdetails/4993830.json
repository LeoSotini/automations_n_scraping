{"4993830": {"success": true, "data": {"type": "game", "name": "Desiderium", "steam_appid": 4993830, "required_age": 0, "is_free": false, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" >Desiderium is a brief 3D exploration narrative game about fulfilling the wishes of an insatiably bitter sovereign. Play as a servant and explore surreal environments, stamping everything that might saciate the whims of the sovereign.</p><p class=\"bb_paragraph\" >A good diet provides nourishment and sustenance to the living. But what happens when you are never satisfied with your food?</p><h2 class=\"bb_tag\" ><strong>Main Features</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Brief narrative focused on the phylosophy of having and dealing with what you desire.</p></li><li><p class=\"bb_paragraph\" >Surreal and atmospheric world to explore.</p></li><li><p class=\"bb_paragraph\" >Nonsensical stories about real life matters.</p></li><li><p class=\"bb_paragraph\" >A Stamp to mark items as appropriate for consumption</p></li><li><p class=\"bb_paragraph\" >A Bop Bag to burn through the stress</p></li><li><p class=\"bb_paragraph\" >Existential Crisis</p></li></ul>", "about_the_game": "<p class=\"bb_paragraph\" >Desiderium is a brief 3D exploration narrative game about fulfilling the wishes of an insatiably bitter sovereign. Play as a servant and explore surreal environments, stamping everything that might saciate the whims of the sovereign.</p><p class=\"bb_paragraph\" >A good diet provides nourishment and sustenance to the living. But what happens when you are never satisfied with your food?</p><h2 class=\"bb_tag\" ><strong>Main Features</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Brief narrative focused on the phylosophy of having and dealing with what you desire.</p></li><li><p class=\"bb_paragraph\" >Surreal and atmospheric world to explore.</p></li><li><p class=\"bb_paragraph\" >Nonsensical stories about real life matters.</p></li><li><p class=\"bb_paragraph\" >A Stamp to mark items as appropriate for consumption</p></li><li><p class=\"bb_paragraph\" >A Bop Bag to burn through the stress</p></li><li><p class=\"bb_paragraph\" >Existential Crisis</p></li></ul>", "short_description": "A brief essay on desires and the consequences of having them. Feed an insaciable sovereign, explore surreal environments, and seek the hiddens ambitions within those who surround you.", "supported_languages": "English<strong>*</strong>, Portuguese - Brazil<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4993830/c215a197f46e2c2b5d3786dc87f34eda5705954a/header.jpg?t=1788144454", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4993830/1aa5e19b2f67f61e05449076b6409e219f00f32c/capsule_231x87.jpg?t=1788144454", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4993830/1aa5e19b2f67f61e05449076b6409e219f00f32c/capsule_184x69.jpg?t=1788144454", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (64 bits)<br></li><li><strong>Processor:</strong> Intel Core i3-8100 ou AMD Ryzen 3 1200<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1050 Ti / AMD Radeon RX 560 ou equivalente<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 5 GB available space<br></li><li><strong>Sound Card:</strong> Compatível com DirectX</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Mafagafos"], "publishers": ["Mafagafos"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 28, "description": "Full 