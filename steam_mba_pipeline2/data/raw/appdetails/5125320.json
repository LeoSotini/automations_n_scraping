{"5125320": {"success": true, "data": {"type": "game", "name": "Night Drive", "steam_appid": 5125320, "required_age": 0, "is_free": false, "dlc": [5136490], "detailed_description": "<p class=\"bb_paragraph\" ><strong>Night Drive</strong> is a retro ASCII driving simulator focused on late-night highway cruising. Drive into the quiet dark across infinite procedurally generated roads with dynamic pseudo-3D perspective rendering.</p><h2 class=\"bb_tag\" >Key Features:</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Solitary Atmosphere:</strong> A calm, ambient experience focused entirely on the quiet rhythm of late-night driving—no timers, no rivals, just the road ahead.</p></li><li><p class=\"bb_paragraph\" ><strong>Pure ASCII Graphics</strong>: Rendered entirely using text characters in a clean monochrome retro style, complete with dynamic headlight illumination and a starry sky.</p></li><li><p class=\"bb_paragraph\" ><strong>Manual Driving Mechanics</strong>: Full control over throttle, braking, steering, and a 5-speed manual transmission with RPM telemetry.</p></li><li><p class=\"bb_paragraph\" ><strong>Multiple Track Styles</strong>: Switch between open desert highways, rolling hills, and tight mountain passes with sharp hairpin curves on the fly.</p></li></ul>", "about_the_game": "<p class=\"bb_paragraph\" ><strong>Night Drive</strong> is a retro ASCII driving simulator focused on late-night highway cruising. Drive into the quiet dark across infinite procedurally generated roads with dynamic pseudo-3D perspective rendering.</p><h2 class=\"bb_tag\" >Key Features:</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Solitary Atmosphere:</strong> A calm, ambient experience focused entirely on the quiet rhythm of late-night driving—no timers, no rivals, just the road ahead.</p></li><li><p class=\"bb_paragraph\" ><strong>Pure ASCII Graphics</strong>: Rendered entirely using text characters in a clean monochrome retro style, complete with dynamic headlight illumination and a starry sky.</p></li><li><p class=\"bb_paragraph\" ><strong>Manual Driving Mechanics</strong>: Full control over throttle, braking, steering, and a 5-speed manual transmission with RPM telemetry.</p></li><li><p class=\"bb_paragraph\" ><strong>Multiple Track Styles</strong>: Switch between open desert highways, rolling hills, and tight mountain passes with sharp hairpin curves on the fly.</p></li></ul>", "short_description": "Night Drive is a minimalist, ASCII-rendered pseudo-3D night driving simulator. Cruise down endless, quiet highways and illuminate the dark road ahead.", "supported_languages": "English", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/5125320/763dbc12ba79c4f1f539a989897a147ce5f306b8/header.jpg?t=1787997197", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/5125320/1123883a9049fc8bd948ac919a64c383b0566e3a/capsule_231x87.jpg?t=1787997197", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/5125320/1123883a9049fc8bd948ac919a64c383b0566e3a/capsule_184x69.jpg?t=1787997197", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> Dual Core 2 GHz<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Storage:</strong> 500 MB available space</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["K.IDLE"], "publishers": ["K.IDLE"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "25", "description": "Adventure"}, {"id": "4", "description": "Casual"}, {"id": "28", "description": "Simulation"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/5125320/80