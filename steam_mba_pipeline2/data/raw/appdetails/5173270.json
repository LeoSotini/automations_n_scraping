{"5173270": {"success": true, "data": {"type": "game", "name": "ZomBMart", "steam_appid": 5173270, "required_age": 0, "is_free": true, "controller_support": "full", "detailed_description": "<p class=\"bb_paragraph\" >Welcome to your first shift at <i>Zom</i>BMart, where customer satisfaction is our top priority! Please make sure to complete your tasks in a timely manner, the more you do, the more you get paid. </p><p class=\"bb_paragraph\" >In this post-apocalyptic world, we aim to keep all undead and alive customers satisfied. </p><p class=\"bb_paragraph\" ><strong>Collaboration</strong></p><p class=\"bb_paragraph\" >Work together to ensure the highest levels of satisfaction, complete group tasks alongside your individual ones to earn some extra cash.</p><p class=\"bb_paragraph\" ><strong>Competition</strong></p><p class=\"bb_paragraph\" >The employee with the most money at the end of your shifts will be our MVP.</p><p class=\"bb_paragraph\" >Use our vending machine to purchase snacks that will help you out in the next round, but be careful, your coworker may give you an out-of-date snack which will disadvantage you in your next shift together.</p><p class=\"bb_paragraph\" ></p>", "about_the_game": "<p class=\"bb_paragraph\" >Welcome to your first shift at <i>Zom</i>BMart, where customer satisfaction is our top priority! Please make sure to complete your tasks in a timely manner, the more you do, the more you get paid. </p><p class=\"bb_paragraph\" >In this post-apocalyptic world, we aim to keep all undead and alive customers satisfied. </p><p class=\"bb_paragraph\" ><strong>Collaboration</strong></p><p class=\"bb_paragraph\" >Work together to ensure the highest levels of satisfaction, complete group tasks alongside your individual ones to earn some extra cash.</p><p class=\"bb_paragraph\" ><strong>Competition</strong></p><p class=\"bb_paragraph\" >The employee with the most money at the end of your shifts will be our MVP.</p><p class=\"bb_paragraph\" >Use our vending machine to purchase snacks that will help you out in the next round, but be careful, your coworker may give you an out-of-date snack which will disadvantage you in your next shift together.</p><p class=\"bb_paragraph\" ></p>", "short_description": "ZomBMart is a couch co-opetition game where the chaos of a casual supermarket job meets the zombie apocalypse. 1-4 players clock in to their casual job, compete and cooperate to complete tasks and make sure all customers are satisfied (especially the undead ones).", "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support", "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/5173270/bdd50fc3a2a86eb20e2f17f9fa935a6f1607d4f8/header.jpg?t=1787978069", "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/5173270/11420f33e798b2f73e60d91af647134564a1abf8/capsule_231x87.jpg?t=1787978069", "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/5173270/11420f33e798b2f73e60d91af647134564a1abf8/capsule_184x69.jpg?t=1787978069", "website": null, "pc_requirements": {"minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 64-bit<br></li><li><strong>Processor:</strong> Intel i5-8400 / AMD Ryzen 5 2600<br></li><li><strong>Memory:</strong> 8 MB RAM<br></li><li><strong>Graphics:</strong> GTX 1060 6 GB / RX 580 8 GB<br></li><li><strong>DirectX:</strong> Version 12</li></ul>"}, "mac_requirements": [], "linux_requirements": [], "developers": ["Ink Inc"], "publishers": ["Ink Inc"], "package_groups": [], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 1, "description": "Multi-player"}, {"id": 49, "description": "PvP"}, {"id": 37, "description": "Shared/Split Screen PvP"}, {"id": 9, "description": "Co-op"}, {"id": 39, "description": "Shared/Split Screen Co-op"}, {"id": 24, "description": "Shared/Split Screen"}, {"id": 28, "d