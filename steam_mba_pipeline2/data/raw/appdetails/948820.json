cense": false, "price_in_cents_with_discount": 1299}]}], "platforms": {"windows": true, "mac": false, "linux": false}, "categories": [{"id": 2, "description": "Single-player"}, {"id": 22, "description": "Steam Achievements"}, {"id": 23, "description": "Steam Cloud"}, {"id": 62, "description": "Family Sharing"}], "genres": [{"id": "4", "description": "Casual"}, {"id": "23", "description": "Indie"}, {"id": "3", "description": "RPG"}], "screenshots": [{"id": 0, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/948820/515c20f0c0d52a769da1cc8b70f9c101def1604d/ss_515c20f0c0d52a769da1cc8b70f9c101def1604d.600x338.jpg?t=1784287808", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/948820/515c20f0c0d52a769da1cc8b70f9c101def1604d/ss_515c20f0c0d52a769da1cc8b70f9c101def1604d.1920x1080.jpg?t=1784287808"}, {"id": 1, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/948820/5f6102412c5168215ef296a184569984b296f7e3/ss_5f6102412c5168215ef296a184569984b296f7e3.600x338.jpg?t=1784287808", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/948820/5f6102412c5168215ef296a184569984b296f7e3/ss_5f6102412c5168215ef296a184569984b296f7e3.1920x1080.jpg?t=1784287808"}, {"id": 2, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/948820/dab816ebf5b9b7c07041e02c958e0ac3aa850f76/ss_dab816ebf5b9b7c07041e02c958e0ac3aa850f76.600x338.jpg?t=1784287808", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/948820/dab816ebf5b9b7c07041e02c958e0ac3aa850f76/ss_dab816ebf5b9b7c07041e02c958e0ac3aa850f76.1920x1080.jpg?t=1784287808"}, {"id": 3, "path_thumbnail": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/948820/753784ea13f6cc371904a7c4c0b76e2050738a86/ss_753784ea13f6cc371904a7c4c0b76e2050738a86.600x338.jpg?t=1784287808", "path_full": "https://shared.akamai.steamstatic.com/store_item_assets/steam/ap